#!/usr/bin/env bash
# pv-quality - Quality scoring and health dashboard
# Usage: pv-quality [command] [args]
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/pv-lib.sh"

check_deps dolt jq awk
ensure_vault

cmd="${1:-dashboard}"
shift || true

usage() {
    cat << 'EOF'
Usage: pv-quality <command> [args]

Commands:
  dashboard              Show quality dashboard
  check                  Run fail-closed quality health checks
  coverage [limit]       Show evidence coverage by active entity (default: 25)
  rollup [dimension]     Aggregate quality/evidence by governed template dimension (default: control_mode)
  template <name>        Show template quality breakdown
  skill <name>           Show skill quality breakdown
  report [output]        Generate markdown quality report
  low [threshold]        Show items below threshold (default: 60)

Scoring:
  Templates: Description (0-20), Content (0-15), Usage (0-25), Ratings (0-40)
  Skills: Description (0-20), README (0-20), License (0-10), Usage (0-25), Ratings (0-25)

Coverage:
  Feedback/capture percentages use execution count as the denominator.
  Private captures stay aggregated-only; no raw output text is rendered.

Rollup dimensions:
  artifact_kind | control_mode | formalization_level | owner_company | visibility_companies
  routing_context | activity_phase | input_artifact | transition_target_type | selection_principles | output_commitment

Grades:
  A: 90+, B: 80-89, C: 70-79, D: 60-69, F: <60
EOF
}

require_active_template() {
    local name="$1"
    local escaped_name
    local count

    escaped_name=$(sql_escape "$name")
    count=$(dolt sql -r csv -q "SELECT COUNT(*) FROM prompt_templates WHERE name = '$escaped_name' AND status = 'active'" | tail -1)

    if [ "${count:-0}" -eq 0 ]; then
        error "Active template '$name' not found" >&2
        exit 1
    fi

    printf '%s' "$escaped_name"
}

require_active_skill() {
    local name="$1"
    local escaped_name
    local count

    escaped_name=$(sql_escape "$name")
    count=$(dolt sql -r csv -q "SELECT COUNT(*) FROM skills WHERE name = '$escaped_name' AND status = 'active'" | tail -1)

    if [ "${count:-0}" -eq 0 ]; then
        error "Active skill '$name' not found" >&2
        exit 1
    fi

    printf '%s' "$escaped_name"
}

run_query() {
    dolt sql -q "$1" -r tabular
}

coverage_union_sql() {
    cat <<'EOF'
SELECT * FROM (
    SELECT
        'template' as entity_type,
        t.name as name,
        COUNT(e.id) as executions,
        COUNT(f.id) as feedback_rows,
        ROUND(COUNT(f.id) * 100.0 / NULLIF(COUNT(e.id), 0), 1) as feedback_rate_pct,
        SUM(CASE WHEN e.output_text IS NOT NULL THEN 1 ELSE 0 END) as captured_executions,
        ROUND(
            SUM(CASE WHEN e.output_text IS NOT NULL THEN 1 ELSE 0 END) * 100.0 / NULLIF(COUNT(e.id), 0),
            1
        ) as capture_rate_pct,
        SUM(CASE WHEN e.output_capture_mode = 'private' AND e.output_text IS NOT NULL THEN 1 ELSE 0 END) as private_captures,
        SUM(CASE WHEN e.output_capture_mode = 'public' AND e.output_text IS NOT NULL THEN 1 ELSE 0 END) as public_captures,
        MAX(e.created_at) as last_execution_at,
        MAX(CASE WHEN f.id IS NOT NULL THEN e.created_at ELSE NULL END) as last_feedback_at,
        MAX(CASE WHEN e.output_text IS NOT NULL THEN e.created_at ELSE NULL END) as last_capture_at
    FROM prompt_templates t
    LEFT JOIN executions e ON e.entity_type = 'template' AND e.entity_id = t.id
    LEFT JOIN feedback f ON f.execution_id = e.id
    WHERE t.status = 'active'
    GROUP BY t.id, t.name

    UNION ALL

    SELECT
        'skill' as entity_type,
        s.name as name,
        COUNT(e.id) as executions,
        COUNT(f.id) as feedback_rows,
        ROUND(COUNT(f.id) * 100.0 / NULLIF(COUNT(e.id), 0), 1) as feedback_rate_pct,
        SUM(CASE WHEN e.output_text IS NOT NULL THEN 1 ELSE 0 END) as captured_executions,
        ROUND(
            SUM(CASE WHEN e.output_text IS NOT NULL THEN 1 ELSE 0 END) * 100.0 / NULLIF(COUNT(e.id), 0),
            1
        ) as capture_rate_pct,
        SUM(CASE WHEN e.output_capture_mode = 'private' AND e.output_text IS NOT NULL THEN 1 ELSE 0 END) as private_captures,
        SUM(CASE WHEN e.output_capture_mode = 'public' AND e.output_text IS NOT NULL THEN 1 ELSE 0 END) as public_captures,
        MAX(e.created_at) as last_execution_at,
        MAX(CASE WHEN f.id IS NOT NULL THEN e.created_at ELSE NULL END) as last_feedback_at,
        MAX(CASE WHEN e.output_text IS NOT NULL THEN e.created_at ELSE NULL END) as last_capture_at
    FROM skills s
    LEFT JOIN executions e ON e.entity_type = 'skill' AND e.entity_id = s.id
    LEFT JOIN feedback f ON f.execution_id = e.id
    WHERE s.status = 'active'
    GROUP BY s.id, s.name
) coverage
EOF
}

coverage_table_sql() {
    local limit="$1"
    cat <<EOF
$(coverage_union_sql)
ORDER BY
    CASE WHEN executions > 0 THEN 0 ELSE 1 END,
    COALESCE(feedback_rate_pct, -1) ASC,
    COALESCE(capture_rate_pct, -1) ASC,
    executions DESC,
    entity_type,
    name
LIMIT $limit
EOF
}

coverage_gaps_sql() {
    local limit="$1"
    cat <<EOF
$(coverage_union_sql)
WHERE executions > 0
  AND (
        feedback_rows = 0
     OR captured_executions = 0
     OR COALESCE(feedback_rate_pct, 0) < 50
     OR COALESCE(capture_rate_pct, 0) < 50
  )
ORDER BY
    CASE
        WHEN feedback_rows = 0 AND captured_executions = 0 THEN 0
        WHEN captured_executions = 0 THEN 1
        WHEN feedback_rows = 0 THEN 2
        ELSE 3
    END,
    COALESCE(feedback_rate_pct, 0) ASC,
    COALESCE(capture_rate_pct, 0) ASC,
    executions DESC,
    entity_type,
    name
LIMIT $limit
EOF
}

entity_coverage_sql() {
    local entity_type="$1"
    local escaped_name="$2"
    local table
    local alias

    case "$entity_type" in
        template)
            table="prompt_templates"
            alias="t"
            ;;
        skill)
            table="skills"
            alias="s"
            ;;
        *)
            error "Unknown entity type for coverage: $entity_type" >&2
            exit 1
            ;;
    esac

    cat <<EOF
SELECT
    COUNT(e.id) as executions,
    COUNT(f.id) as feedback_rows,
    ROUND(COUNT(f.id) * 100.0 / NULLIF(COUNT(e.id), 0), 1) as feedback_rate_pct,
    SUM(CASE WHEN e.output_text IS NOT NULL THEN 1 ELSE 0 END) as captured_executions,
    ROUND(
        SUM(CASE WHEN e.output_text IS NOT NULL THEN 1 ELSE 0 END) * 100.0 / NULLIF(COUNT(e.id), 0),
        1
    ) as capture_rate_pct,
    SUM(CASE WHEN e.output_capture_mode = 'private' AND e.output_text IS NOT NULL THEN 1 ELSE 0 END) as private_captures,
    SUM(CASE WHEN e.output_capture_mode = 'public' AND e.output_text IS NOT NULL THEN 1 ELSE 0 END) as public_captures,
    ROUND(AVG(CASE WHEN e.output_text IS NOT NULL THEN CHAR_LENGTH(e.output_text) END)) as avg_captured_chars,
    MAX(e.created_at) as last_execution_at,
    MAX(CASE WHEN f.id IS NOT NULL THEN e.created_at ELSE NULL END) as last_feedback_at,
    MAX(CASE WHEN e.output_text IS NOT NULL THEN e.created_at ELSE NULL END) as last_capture_at
FROM $table $alias
LEFT JOIN executions e ON e.entity_type = '$entity_type' AND e.entity_id = $alias.id
LEFT JOIN feedback f ON f.execution_id = e.id
WHERE $alias.name = '$escaped_name' AND $alias.status = 'active'
EOF
}

template_rollup_entity_stats_sql() {
    cat <<'EOF'
SELECT
    e.entity_id,
    COUNT(*) as executions,
    COUNT(f.id) as feedback_rows,
    SUM(CASE WHEN e.output_text IS NOT NULL THEN 1 ELSE 0 END) as captured_executions,
    SUM(CASE WHEN e.output_capture_mode = 'private' AND e.output_text IS NOT NULL THEN 1 ELSE 0 END) as private_captures,
    SUM(CASE WHEN e.output_capture_mode = 'public' AND e.output_text IS NOT NULL THEN 1 ELSE 0 END) as public_captures,
    SUM(CASE WHEN f.rating IS NOT NULL THEN f.rating ELSE 0 END) as rating_sum,
    COUNT(f.rating) as rating_rows,
    AVG(f.rating) as avg_rating,
    MAX(e.created_at) as last_execution_at
FROM executions e
LEFT JOIN feedback f ON f.execution_id = e.id
WHERE e.entity_type = 'template'
GROUP BY e.entity_id
EOF
}

contract_bucket_table_sql() {
    local contract="$1"
    local jq_path="$2"
    local label="$3"
    local values=()
    local i

    [ -f "$contract" ] || {
        error "Missing $label contract: $contract" >&2
        exit 1
    }

    mapfile -t values < <(jq -r "$jq_path[]" "$contract")

    [ "${#values[@]}" -gt 0 ] || {
        error "No governed $label values found in $contract" >&2
        exit 1
    }

    for i in "${!values[@]}"; do
        local escaped_value
        escaped_value=$(sql_escape "${values[$i]}")
        if [ "$i" -gt 0 ]; then
            printf '\nUNION ALL\n'
        fi
        printf "SELECT '%s' as bucket" "$escaped_value"
    done
}

selection_principles_bucket_table_sql() {
    contract_bucket_table_sql "$SCRIPT_DIR/../ontology/controlled-vocabulary-contract.json" '.dimensions.selection_principles' "selection_principles"
}

visibility_companies_bucket_table_sql() {
    contract_bucket_table_sql "$SCRIPT_DIR/../ontology/company-visibility-contract.json" '.companies' "company visibility"
}

normalize_rollup_dimension() {
    local dimension="${1:-control_mode}"

    case "$dimension" in
        artifact_kind|control_mode|formalization_level|owner_company|visibility_companies|routing_context|activity_phase|input_artifact|transition_target_type|selection_principles|output_commitment)
            printf '%s' "$dimension"
            ;;
        *)
            error "Unsupported rollup dimension: $dimension" >&2
            error "Allowed dimensions: artifact_kind, control_mode, formalization_level, owner_company, visibility_companies, routing_context, activity_phase, input_artifact, transition_target_type, selection_principles, output_commitment" >&2
            exit 1
            ;;
    esac
}

rollup_bucket_expr() {
    local dimension="$1"

    case "$dimension" in
        artifact_kind|control_mode|formalization_level|owner_company)
            printf 't.%s' "$dimension"
            ;;
        routing_context|activity_phase|input_artifact|transition_target_type|output_commitment)
            printf "JSON_UNQUOTE(JSON_EXTRACT(t.controlled_vocabulary, '$.%s'))" "$dimension"
            ;;
        *)
            error "Unsupported exact-one rollup dimension: $dimension" >&2
            exit 1
            ;;
    esac
}

rollup_dimension_where_clause() {
    local dimension="$1"

    case "$dimension" in
        artifact_kind|control_mode|formalization_level|owner_company)
            printf "%s" "t.status = 'active'"
            ;;
        routing_context|activity_phase|input_artifact|transition_target_type|output_commitment)
            printf "t.status = 'active' AND t.artifact_kind = 'procedure' AND t.control_mode = 'router' AND t.controlled_vocabulary IS NOT NULL AND JSON_EXTRACT(t.controlled_vocabulary, '$.%s') IS NOT NULL" "$dimension"
            ;;
        *)
            error "Unsupported exact-one rollup dimension: $dimension" >&2
            exit 1
            ;;
    esac
}

quality_rollup_sql() {
    local dimension="$1"
    local bucket_expr
    local where_clause
    local stats_sql

    stats_sql=$(template_rollup_entity_stats_sql)

    if [ "$dimension" = "selection_principles" ] || [ "$dimension" = "visibility_companies" ]; then
        local bucket_table_sql
        local base_join_clause
        local bucket_join_clause

        if [ "$dimension" = "selection_principles" ]; then
            bucket_table_sql=$(selection_principles_bucket_table_sql)
            base_join_clause="t.status = 'active' AND t.artifact_kind = 'procedure' AND t.control_mode = 'router' AND t.controlled_vocabulary IS NOT NULL"
            bucket_join_clause="JSON_SEARCH(t.controlled_vocabulary, 'one', buckets.bucket, NULL, '$.selection_principles[*]') IS NOT NULL"
        else
            bucket_table_sql=$(visibility_companies_bucket_table_sql)
            base_join_clause="t.status = 'active' AND t.visibility_companies IS NOT NULL"
            bucket_join_clause="JSON_SEARCH(t.visibility_companies, 'one', buckets.bucket) IS NOT NULL"
        fi

        cat <<EOF
SELECT
    buckets.bucket as bucket,
    COUNT(*) as entities,
    SUM(CASE WHEN COALESCE(es.executions, 0) > 0 THEN 1 ELSE 0 END) as entities_with_executions,
    SUM(COALESCE(es.executions, 0)) as executions,
    SUM(COALESCE(es.feedback_rows, 0)) as feedback_rows,
    ROUND(
        SUM(COALESCE(es.feedback_rows, 0)) * 100.0 / NULLIF(SUM(COALESCE(es.executions, 0)), 0),
        1
    ) as feedback_rate_pct,
    SUM(COALESCE(es.captured_executions, 0)) as captured_executions,
    ROUND(
        SUM(COALESCE(es.captured_executions, 0)) * 100.0 / NULLIF(SUM(COALESCE(es.executions, 0)), 0),
        1
    ) as capture_rate_pct,
    SUM(COALESCE(es.private_captures, 0)) as private_captures,
    SUM(COALESCE(es.public_captures, 0)) as public_captures,
    ROUND(
        SUM(COALESCE(es.rating_sum, 0)) / NULLIF(SUM(COALESCE(es.rating_rows, 0)), 0),
        2
    ) as avg_rating,
    ROUND(AVG(
        (CASE
            WHEN CHAR_LENGTH(COALESCE(t.description, '')) BETWEEN 50 AND 150 THEN 20
            WHEN CHAR_LENGTH(COALESCE(t.description, '')) >= 20 THEN 10
            ELSE 0
         END)
      + (CASE
            WHEN CHAR_LENGTH(COALESCE(t.content, '')) >= 100 THEN 15
            WHEN CHAR_LENGTH(COALESCE(t.content, '')) >= 50 THEN 10
            WHEN CHAR_LENGTH(COALESCE(t.content, '')) >= 20 THEN 5
            ELSE 0
         END)
      + (CASE
            WHEN COALESCE(es.executions, 0) >= 10 THEN 25
            WHEN COALESCE(es.executions, 0) >= 5 THEN 15
            WHEN COALESCE(es.executions, 0) >= 1 THEN 5
            ELSE 0
         END)
      + (CASE
            WHEN COALESCE(es.avg_rating, 0) > 4 THEN 40
            WHEN COALESCE(es.avg_rating, 0) > 3 THEN 30
            WHEN COALESCE(es.avg_rating, 0) > 2 THEN 20
            WHEN COALESCE(es.avg_rating, 0) > 0 THEN 10
            ELSE 0
         END)
    ), 1) as avg_quality_score,
    MAX(es.last_execution_at) as last_execution_at
FROM (
$bucket_table_sql
) buckets
JOIN prompt_templates t
  ON $base_join_clause
 AND $bucket_join_clause
LEFT JOIN (
$stats_sql
) es ON es.entity_id = t.id
GROUP BY buckets.bucket
ORDER BY executions DESC, entities DESC, bucket
EOF
        return
    fi

    bucket_expr=$(rollup_bucket_expr "$dimension")
    where_clause=$(rollup_dimension_where_clause "$dimension")

    cat <<EOF
SELECT
    $bucket_expr as bucket,
    COUNT(*) as entities,
    SUM(CASE WHEN COALESCE(es.executions, 0) > 0 THEN 1 ELSE 0 END) as entities_with_executions,
    SUM(COALESCE(es.executions, 0)) as executions,
    SUM(COALESCE(es.feedback_rows, 0)) as feedback_rows,
    ROUND(
        SUM(COALESCE(es.feedback_rows, 0)) * 100.0 / NULLIF(SUM(COALESCE(es.executions, 0)), 0),
        1
    ) as feedback_rate_pct,
    SUM(COALESCE(es.captured_executions, 0)) as captured_executions,
    ROUND(
        SUM(COALESCE(es.captured_executions, 0)) * 100.0 / NULLIF(SUM(COALESCE(es.executions, 0)), 0),
        1
    ) as capture_rate_pct,
    SUM(COALESCE(es.private_captures, 0)) as private_captures,
    SUM(COALESCE(es.public_captures, 0)) as public_captures,
    ROUND(
        SUM(COALESCE(es.rating_sum, 0)) / NULLIF(SUM(COALESCE(es.rating_rows, 0)), 0),
        2
    ) as avg_rating,
    ROUND(AVG(
        (CASE
            WHEN CHAR_LENGTH(COALESCE(t.description, '')) BETWEEN 50 AND 150 THEN 20
            WHEN CHAR_LENGTH(COALESCE(t.description, '')) >= 20 THEN 10
            ELSE 0
         END)
      + (CASE
            WHEN CHAR_LENGTH(COALESCE(t.content, '')) >= 100 THEN 15
            WHEN CHAR_LENGTH(COALESCE(t.content, '')) >= 50 THEN 10
            WHEN CHAR_LENGTH(COALESCE(t.content, '')) >= 20 THEN 5
            ELSE 0
         END)
      + (CASE
            WHEN COALESCE(es.executions, 0) >= 10 THEN 25
            WHEN COALESCE(es.executions, 0) >= 5 THEN 15
            WHEN COALESCE(es.executions, 0) >= 1 THEN 5
            ELSE 0
         END)
      + (CASE
            WHEN COALESCE(es.avg_rating, 0) > 4 THEN 40
            WHEN COALESCE(es.avg_rating, 0) > 3 THEN 30
            WHEN COALESCE(es.avg_rating, 0) > 2 THEN 20
            WHEN COALESCE(es.avg_rating, 0) > 0 THEN 10
            ELSE 0
         END)
    ), 1) as avg_quality_score,
    MAX(es.last_execution_at) as last_execution_at
FROM prompt_templates t
LEFT JOIN (
$stats_sql
) es ON es.entity_id = t.id
WHERE $where_clause
GROUP BY $bucket_expr
ORDER BY executions DESC, entities DESC, bucket
EOF
}

calculate_template_score() {
    local name="$1"
    local escaped_name
    local score=0
    local data
    local content_len
    local desc_len
    local executions
    local avg_rating

    escaped_name=$(sql_escape "$name")
    data=$(dolt sql -r json -q "
        SELECT
            CHAR_LENGTH(content) as content_len,
            CHAR_LENGTH(description) as desc_len,
            (SELECT COUNT(*) FROM executions e WHERE e.entity_type = 'template' AND e.entity_id = t.id) as executions,
            (SELECT AVG(rating) FROM executions e JOIN feedback f ON f.execution_id = e.id WHERE e.entity_type = 'template' AND e.entity_id = t.id) as avg_rating
        FROM prompt_templates t
        WHERE name = '$escaped_name' AND status = 'active'
        LIMIT 1
    " 2>/dev/null | jq -r '.rows[0] // empty')

    [ -z "$data" ] && echo "0" && return

    content_len=$(echo "$data" | jq -r '.content_len // 0')
    desc_len=$(echo "$data" | jq -r '.desc_len // 0')
    executions=$(echo "$data" | jq -r '.executions // 0')
    avg_rating=$(echo "$data" | jq -r '.avg_rating // 0')

    if [ "$desc_len" -ge 50 ] && [ "$desc_len" -le 150 ]; then
        score=$((score + 20))
    elif [ "$desc_len" -ge 20 ]; then
        score=$((score + 10))
    fi

    if [ "$content_len" -ge 100 ]; then
        score=$((score + 15))
    elif [ "$content_len" -ge 50 ]; then
        score=$((score + 10))
    elif [ "$content_len" -ge 20 ]; then
        score=$((score + 5))
    fi

    if [ "$executions" -ge 10 ]; then
        score=$((score + 25))
    elif [ "$executions" -ge 5 ]; then
        score=$((score + 15))
    elif [ "$executions" -ge 1 ]; then
        score=$((score + 5))
    fi

    if float_gt "$avg_rating" 4; then
        score=$((score + 40))
    elif float_gt "$avg_rating" 3; then
        score=$((score + 30))
    elif float_gt "$avg_rating" 2; then
        score=$((score + 20))
    elif float_gt "$avg_rating" 0; then
        score=$((score + 10))
    fi

    echo "$score"
}

calculate_skill_score() {
    local name="$1"
    local escaped_name
    local score=0
    local data
    local readme_len
    local desc_len
    local license
    local executions
    local avg_rating

    escaped_name=$(sql_escape "$name")
    data=$(dolt sql -r json -q "
        SELECT
            CHAR_LENGTH(readme) as readme_len,
            CHAR_LENGTH(description) as desc_len,
            license,
            (SELECT COUNT(*) FROM executions e WHERE e.entity_type = 'skill' AND e.entity_id = s.id) as executions,
            (SELECT AVG(rating) FROM executions e JOIN feedback f ON f.execution_id = e.id WHERE e.entity_type = 'skill' AND e.entity_id = s.id) as avg_rating
        FROM skills s
        WHERE name = '$escaped_name' AND status = 'active'
        LIMIT 1
    " 2>/dev/null | jq -r '.rows[0] // empty')

    [ -z "$data" ] && echo "0" && return

    readme_len=$(echo "$data" | jq -r '.readme_len // 0')
    desc_len=$(echo "$data" | jq -r '.desc_len // 0')
    license=$(echo "$data" | jq -r '.license // empty')
    executions=$(echo "$data" | jq -r '.executions // 0')
    avg_rating=$(echo "$data" | jq -r '.avg_rating // 0')

    [ "$desc_len" -ge 50 ] && score=$((score + 20))
    [ "$desc_len" -ge 20 ] && [ "$desc_len" -lt 50 ] && score=$((score + 10))

    [ "$readme_len" -ge 500 ] && score=$((score + 20))
    [ "$readme_len" -ge 200 ] && [ "$readme_len" -lt 500 ] && score=$((score + 10))

    [ -n "$license" ] && score=$((score + 10))

    [ "$executions" -ge 10 ] && score=$((score + 25))
    [ "$executions" -ge 5 ] && [ "$executions" -lt 10 ] && score=$((score + 15))
    [ "$executions" -ge 1 ] && [ "$executions" -lt 5 ] && score=$((score + 5))

    if float_gt "$avg_rating" 4; then
        score=$((score + 25))
    elif float_gt "$avg_rating" 3; then
        score=$((score + 20))
    elif float_gt "$avg_rating" 2; then
        score=$((score + 10))
    fi

    echo "$score"
}

get_grade() {
    local score="$1"

    if [ "$score" -ge 90 ]; then echo "A"
    elif [ "$score" -ge 80 ]; then echo "B"
    elif [ "$score" -ge 70 ]; then echo "C"
    elif [ "$score" -ge 60 ]; then echo "D"
    else echo "F"
    fi
}

case "$cmd" in
    dashboard)
        echo "╔════════════════════════════════════════════════════════════════╗"
        echo "║                    PROMPT VAULT QUALITY                        ║"
        echo "╚════════════════════════════════════════════════════════════════╝"
        echo ""

        total_templates=$(dolt sql -r csv -q "SELECT COUNT(*) FROM prompt_templates WHERE status = 'active'" | tail -1)
        total_skills=$(dolt sql -r csv -q "SELECT COUNT(*) FROM skills WHERE status = 'active'" | tail -1)
        total_executions=$(dolt sql -r csv -q "SELECT COUNT(*) FROM executions" | tail -1)
        total_feedback=$(dolt sql -r csv -q "SELECT COUNT(*) FROM feedback" | tail -1)
        captured_executions=$(dolt sql -r csv -q "SELECT COUNT(*) FROM executions WHERE output_text IS NOT NULL" | tail -1)
        private_captures=$(dolt sql -r csv -q "SELECT COUNT(*) FROM executions WHERE output_capture_mode = 'private' AND output_text IS NOT NULL" | tail -1)
        public_captures=$(dolt sql -r csv -q "SELECT COUNT(*) FROM executions WHERE output_capture_mode = 'public' AND output_text IS NOT NULL" | tail -1)
        capture_rate=$(dolt sql -r csv -q "SELECT ROUND(COUNT(*) * 100.0 / NULLIF((SELECT COUNT(*) FROM executions), 0), 1) FROM executions WHERE output_text IS NOT NULL" | tail -1)
        feedback_rate=$(dolt sql -r csv -q "SELECT ROUND(COUNT(*) * 100.0 / NULLIF((SELECT COUNT(*) FROM executions), 0), 1) FROM feedback" | tail -1)

        echo "Overview"
        echo "─────────────────────────────────────"
        printf "  Templates:    %4s   Skills:       %3s\n" "$total_templates" "$total_skills"
        printf "  Executions:   %4s   Feedback:     %3s\n" "$total_executions" "$total_feedback"
        echo ""
        echo "Evidence Coverage"
        echo "─────────────────────────────────────"
        printf "  Captured:     %4s   Capture rate: %6s%%\n" "$captured_executions" "${capture_rate:-0.0}"
        printf "  Private:      %4s   Public:       %3s\n" "$private_captures" "$public_captures"
        printf "  Feedback rate:%4s%%\n" "${feedback_rate:-0.0}"
        echo ""

        echo "Entities Needing More Evidence"
        echo "─────────────────────────────────────"
        run_query "$(coverage_gaps_sql 10)"
        echo ""

        echo "Template Quality Scores"
        echo "─────────────────────────────────────"
        printf "%-25s %6s %6s\n" "NAME" "SCORE" "GRADE"
        echo "─────────────────────────────────────"

        dolt sql -r csv -q "SELECT name FROM prompt_templates WHERE status = 'active' ORDER BY name" | tail -n +2 | while read -r name; do
            [ -z "$name" ] && continue
            score=$(calculate_template_score "$name")
            grade=$(get_grade "$score")
            printf "%-25s %6s %6s\n" "$name" "$score" "$grade"
        done

        echo ""
        echo "Skill Quality Scores"
        echo "─────────────────────────────────────"
        printf "%-25s %6s %6s\n" "NAME" "SCORE" "GRADE"
        echo "─────────────────────────────────────"

        dolt sql -r csv -q "SELECT name FROM skills WHERE status = 'active' ORDER BY name" | tail -n +2 | while read -r name; do
            [ -z "$name" ] && continue
            score=$(calculate_skill_score "$name")
            grade=$(get_grade "$score")
            printf "%-25s %6s %6s\n" "$name" "$score" "$grade"
        done

        echo ""
        echo "Score Components: Description (0-20), Content (0-15), Usage (0-25), Ratings (0-40)"
        ;;

    check)
        template_count=$(dolt sql -r csv -q "SELECT COUNT(*) FROM prompt_templates WHERE status = 'active'" | tail -1)
        skill_count=$(dolt sql -r csv -q "SELECT COUNT(*) FROM skills WHERE status = 'active'" | tail -1)
        execution_count=$(dolt sql -r csv -q "SELECT COUNT(*) FROM executions" | tail -1)
        first_template=$(dolt sql -r csv -q "SELECT name FROM prompt_templates WHERE status = 'active' ORDER BY name LIMIT 1" | tail -1)
        coverage_sample=$(dolt sql -r csv -q "$(coverage_table_sql 1)" | tail -n +2 | head -n 1 || true)

        if [ -n "$first_template" ]; then
            sample_score=$(calculate_template_score "$first_template")
            [[ "$sample_score" =~ ^[0-9]+$ ]] || {
                error "Computed non-numeric quality score for '$first_template'"
                exit 1
            }
        fi

        if [ -z "$coverage_sample" ] && { [ "${template_count:-0}" -gt 0 ] || [ "${skill_count:-0}" -gt 0 ]; }; then
            error "Evidence coverage query returned no rows"
            exit 1
        fi

        echo "Quality checks passed"
        echo "  Active templates: ${template_count:-0}"
        echo "  Active skills: ${skill_count:-0}"
        echo "  Executions: ${execution_count:-0}"
        [ -n "$first_template" ] && echo "  Sample score: $first_template -> $sample_score"
        ;;

    coverage)
        limit="${1:-25}"
        require_numeric "$limit" "limit"
        echo "=== Evidence Coverage by Active Entity ==="
        echo "Feedback/capture percentages use execution count as the denominator. No raw output text is rendered here."
        echo ""
        run_query "$(coverage_table_sql "$limit")"
        ;;

    rollup)
        dimension=$(normalize_rollup_dimension "${1:-control_mode}")
        echo "=== Quality Rollup by $dimension ==="
        echo "Aggregate-only report across active templates. Private captures remain summarized only."
        echo ""
        run_query "$(quality_rollup_sql "$dimension")"
        ;;

    template)
        name="${1:-}"
        [ -z "$name" ] && { error "Usage: pv-quality template <name>"; exit 1; }
        escaped_name=$(require_active_template "$name")

        score=$(calculate_template_score "$name")
        grade=$(get_grade "$score")

        echo "=== $name Quality Score ==="
        echo ""
        echo "Score: $score/100"
        echo "Grade: $grade"
        echo ""

        run_query "
            SELECT
                CHAR_LENGTH(content) as content_chars,
                CHAR_LENGTH(description) as desc_chars,
                (SELECT COUNT(*) FROM executions e WHERE e.entity_type = 'template' AND e.entity_id = t.id) as uses,
                (SELECT ROUND(AVG(rating), 2) FROM executions e JOIN feedback f ON f.execution_id = e.id WHERE e.entity_type = 'template' AND e.entity_id = t.id) as avg_rating
            FROM prompt_templates t
            WHERE name = '$escaped_name' AND status = 'active'
        "
        echo ""
        echo "Evidence Coverage"
        run_query "$(entity_coverage_sql template "$escaped_name")"
        ;;

    skill)
        name="${1:-}"
        [ -z "$name" ] && { error "Usage: pv-quality skill <name>"; exit 1; }
        escaped_name=$(require_active_skill "$name")

        score=$(calculate_skill_score "$name")
        grade=$(get_grade "$score")

        echo "=== $name Quality Score ==="
        echo ""
        echo "Score: $score/100"
        echo "Grade: $grade"
        echo ""

        run_query "
            SELECT
                CHAR_LENGTH(readme) as readme_chars,
                CHAR_LENGTH(description) as desc_chars,
                license,
                (SELECT COUNT(*) FROM executions e WHERE e.entity_type = 'skill' AND e.entity_id = s.id) as uses,
                (SELECT ROUND(AVG(rating), 2) FROM executions e JOIN feedback f ON f.execution_id = e.id WHERE e.entity_type = 'skill' AND e.entity_id = s.id) as avg_rating
            FROM skills s
            WHERE name = '$escaped_name' AND status = 'active'
        "
        echo ""
        echo "Evidence Coverage"
        run_query "$(entity_coverage_sql skill "$escaped_name")"
        ;;

    report)
        output="${1:-quality-report.md}"

        echo "Generating quality report..."

        capture_summary_json=$(dolt sql -r json -q "
            SELECT
                COUNT(*) as total_executions,
                COUNT(f.id) as feedback_rows,
                ROUND(COUNT(f.id) * 100.0 / NULLIF(COUNT(*), 0), 1) as feedback_rate_pct,
                SUM(CASE WHEN e.output_text IS NOT NULL THEN 1 ELSE 0 END) as captured_executions,
                ROUND(
                    SUM(CASE WHEN e.output_text IS NOT NULL THEN 1 ELSE 0 END) * 100.0 / NULLIF(COUNT(*), 0),
                    1
                ) as capture_rate_pct,
                SUM(CASE WHEN e.output_capture_mode = 'private' AND e.output_text IS NOT NULL THEN 1 ELSE 0 END) as private_captures,
                SUM(CASE WHEN e.output_capture_mode = 'public' AND e.output_text IS NOT NULL THEN 1 ELSE 0 END) as public_captures
            FROM executions e
            LEFT JOIN feedback f ON f.execution_id = e.id
        ")
        coverage_gaps_json=$(dolt sql -r json -q "$(coverage_gaps_sql 15)")
        report_templates=$(dolt sql -r csv -q "SELECT COUNT(*) FROM prompt_templates WHERE status = 'active'" | tail -1)
        report_skills=$(dolt sql -r csv -q "SELECT COUNT(*) FROM skills WHERE status = 'active'" | tail -1)
        report_executions=$(dolt sql -r csv -q "SELECT COUNT(*) FROM executions" | tail -1)
        report_feedback_rate=$(echo "$capture_summary_json" | jq -r '.rows[0].feedback_rate_pct // 0')
        report_capture_rate=$(echo "$capture_summary_json" | jq -r '.rows[0].capture_rate_pct // 0')
        report_private_captures=$(echo "$capture_summary_json" | jq -r '.rows[0].private_captures // 0')
        report_public_captures=$(echo "$capture_summary_json" | jq -r '.rows[0].public_captures // 0')

        {
            echo "# Prompt Vault Quality Report"
            echo ""
            echo "Generated: $(date)"
            echo ""
            echo "## Summary"
            echo ""
            echo "- Templates: $report_templates"
            echo "- Skills: $report_skills"
            echo "- Executions: $report_executions"
            echo ""
            echo "## Evidence Coverage"
            echo ""
            echo "- Feedback coverage: ${report_feedback_rate}%"
            echo "- Capture coverage: ${report_capture_rate}%"
            echo "- Private captures: $report_private_captures"
            echo "- Public captures: $report_public_captures"
            echo ""
            echo "## Evidence Gaps"
            echo ""
            echo "| Type | Name | Executions | Feedback % | Capture % | Private | Public |"
            echo "|------|------|------------|------------|-----------|---------|--------|"
            echo "$coverage_gaps_json" | jq -r '.rows[] | "| " + .entity_type + " | " + .name + " | " + (.executions|tostring) + " | " + ((.feedback_rate_pct // "n/a")|tostring) + " | " + ((.capture_rate_pct // "n/a")|tostring) + " | " + (.private_captures|tostring) + " | " + (.public_captures|tostring) + " |"'
            echo ""
            echo "## Template Scores"
            echo ""
            echo "| Name | Score | Grade |"
            echo "|------|-------|-------|"

            dolt sql -r csv -q "SELECT name FROM prompt_templates WHERE status = 'active' ORDER BY name" | tail -n +2 | while read -r name; do
                [ -z "$name" ] && continue
                score=$(calculate_template_score "$name")
                grade=$(get_grade "$score")
                echo "| $name | $score | $grade |"
            done

            echo ""
            echo "## Skill Scores"
            echo ""
            echo "| Name | Score | Grade |"
            echo "|------|-------|-------|"

            dolt sql -r csv -q "SELECT name FROM skills WHERE status = 'active' ORDER BY name" | tail -n +2 | while read -r name; do
                [ -z "$name" ] && continue
                score=$(calculate_skill_score "$name")
                grade=$(get_grade "$score")
                echo "| $name | $score | $grade |"
            done
        } > "$output"

        echo "✓ Report saved to $output"
        ;;

    low)
        threshold="${1:-60}"
        require_numeric "$threshold" "threshold"
        echo "=== Items Below $threshold Points ==="
        echo ""

        dolt sql -r csv -q "SELECT name FROM prompt_templates WHERE status = 'active'" | tail -n +2 | while read -r name; do
            [ -z "$name" ] && continue
            score=$(calculate_template_score "$name")
            if [ "$score" -lt "$threshold" ]; then
                echo "  Template: $name ($score pts)"
            fi
        done

        dolt sql -r csv -q "SELECT name FROM skills WHERE status = 'active'" | tail -n +2 | while read -r name; do
            [ -z "$name" ] && continue
            score=$(calculate_skill_score "$name")
            if [ "$score" -lt "$threshold" ]; then
                echo "  Skill: $name ($score pts)"
            fi
        done
        ;;

    help|-h|--help)
        usage
        ;;

    *)
        error "Unknown command: $cmd"
        usage >&2
        exit 1
        ;;
esac
