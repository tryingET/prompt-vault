#!/usr/bin/env bash
# pv-quality - Quality scoring and health dashboard
# Usage: pv-quality [command] [args]
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/pv-lib.sh"

check_deps dolt jq awk
ensure_vault

cmd="${1:-dashboard}"
shift || true

usage() {
    cat << 'EOF'
Usage: pv-quality <command> [args]

Commands:
  dashboard              Show quality dashboard
  check                  Run fail-closed quality health checks
  template <name>        Show template quality breakdown
  skill <name>           Show skill quality breakdown
  report [output]        Generate markdown quality report
  low [threshold]        Show items below threshold (default: 60)

Scoring:
  Templates: Description (0-20), Content (0-15), Usage (0-25), Ratings (0-40)
  Skills: Description (0-20), README (0-20), License (0-10), Usage (0-25), Ratings (0-25)

Grades:
  A: 90+, B: 80-89, C: 70-79, D: 60-69, F: <60
EOF
}

require_active_template() {
    local name="$1"
    local escaped_name
    local count

    escaped_name=$(sql_escape "$name")
    count=$(dolt sql -r csv -q "SELECT COUNT(*) FROM prompt_templates WHERE name = '$escaped_name' AND status = 'active'" | tail -1)

    if [ "${count:-0}" -eq 0 ]; then
        error "Active template '$name' not found" >&2
        exit 1
    fi

    printf '%s' "$escaped_name"
}

require_active_skill() {
    local name="$1"
    local escaped_name
    local count

    escaped_name=$(sql_escape "$name")
    count=$(dolt sql -r csv -q "SELECT COUNT(*) FROM skills WHERE name = '$escaped_name' AND status = 'active'" | tail -1)

    if [ "${count:-0}" -eq 0 ]; then
        error "Active skill '$name' not found" >&2
        exit 1
    fi

    printf '%s' "$escaped_name"
}

calculate_template_score() {
    local name="$1"
    local escaped_name
    local score=0
    local data
    local content_len
    local desc_len
    local executions
    local avg_rating

    escaped_name=$(sql_escape "$name")
    data=$(dolt sql -r json -q "
        SELECT 
            CHAR_LENGTH(content) as content_len,
            CHAR_LENGTH(description) as desc_len,
            (SELECT COUNT(*) FROM executions e WHERE e.entity_type = 'template' AND e.entity_id = t.id) as executions,
            (SELECT AVG(rating) FROM executions e JOIN feedback f ON f.execution_id = e.id WHERE e.entity_type = 'template' AND e.entity_id = t.id) as avg_rating
        FROM prompt_templates t
        WHERE name = '$escaped_name' AND status = 'active'
        LIMIT 1
    " 2>/dev/null | jq -r '.rows[0] // empty')

    [ -z "$data" ] && echo "0" && return

    content_len=$(echo "$data" | jq -r '.content_len // 0')
    desc_len=$(echo "$data" | jq -r '.desc_len // 0')
    executions=$(echo "$data" | jq -r '.executions // 0')
    avg_rating=$(echo "$data" | jq -r '.avg_rating // 0')

    if [ "$desc_len" -ge 50 ] && [ "$desc_len" -le 150 ]; then
        score=$((score + 20))
    elif [ "$desc_len" -ge 20 ]; then
        score=$((score + 10))
    fi

    if [ "$content_len" -ge 100 ]; then
        score=$((score + 15))
    elif [ "$content_len" -ge 50 ]; then
        score=$((score + 10))
    elif [ "$content_len" -ge 20 ]; then
        score=$((score + 5))
    fi

    if [ "$executions" -ge 10 ]; then
        score=$((score + 25))
    elif [ "$executions" -ge 5 ]; then
        score=$((score + 15))
    elif [ "$executions" -ge 1 ]; then
        score=$((score + 5))
    fi

    if float_gt "$avg_rating" 4; then
        score=$((score + 40))
    elif float_gt "$avg_rating" 3; then
        score=$((score + 30))
    elif float_gt "$avg_rating" 2; then
        score=$((score + 20))
    elif float_gt "$avg_rating" 0; then
        score=$((score + 10))
    fi

    echo "$score"
}

calculate_skill_score() {
    local name="$1"
    local escaped_name
    local score=0
    local data
    local readme_len
    local desc_len
    local license
    local executions
    local avg_rating

    escaped_name=$(sql_escape "$name")
    data=$(dolt sql -r json -q "
        SELECT 
            CHAR_LENGTH(readme) as readme_len,
            CHAR_LENGTH(description) as desc_len,
            license,
            (SELECT COUNT(*) FROM executions e WHERE e.entity_type = 'skill' AND e.entity_id = s.id) as executions,
            (SELECT AVG(rating) FROM executions e JOIN feedback f ON f.execution_id = e.id WHERE e.entity_type = 'skill' AND e.entity_id = s.id) as avg_rating
        FROM skills s
        WHERE name = '$escaped_name' AND status = 'active'
        LIMIT 1
    " 2>/dev/null | jq -r '.rows[0] // empty')

    [ -z "$data" ] && echo "0" && return

    readme_len=$(echo "$data" | jq -r '.readme_len // 0')
    desc_len=$(echo "$data" | jq -r '.desc_len // 0')
    license=$(echo "$data" | jq -r '.license // empty')
    executions=$(echo "$data" | jq -r '.executions // 0')
    avg_rating=$(echo "$data" | jq -r '.avg_rating // 0')

    [ "$desc_len" -ge 50 ] && score=$((score + 20))
    [ "$desc_len" -ge 20 ] && [ "$desc_len" -lt 50 ] && score=$((score + 10))

    [ "$readme_len" -ge 500 ] && score=$((score + 20))
    [ "$readme_len" -ge 200 ] && [ "$readme_len" -lt 500 ] && score=$((score + 10))

    [ -n "$license" ] && score=$((score + 10))

    [ "$executions" -ge 10 ] && score=$((score + 25))
    [ "$executions" -ge 5 ] && [ "$executions" -lt 10 ] && score=$((score + 15))
    [ "$executions" -ge 1 ] && [ "$executions" -lt 5 ] && score=$((score + 5))

    if float_gt "$avg_rating" 4; then
        score=$((score + 25))
    elif float_gt "$avg_rating" 3; then
        score=$((score + 20))
    elif float_gt "$avg_rating" 2; then
        score=$((score + 10))
    fi

    echo "$score"
}

get_grade() {
    local score="$1"

    if [ "$score" -ge 90 ]; then echo "A"
    elif [ "$score" -ge 80 ]; then echo "B"
    elif [ "$score" -ge 70 ]; then echo "C"
    elif [ "$score" -ge 60 ]; then echo "D"
    else echo "F"
    fi
}

case "$cmd" in
    dashboard)
        echo "╔════════════════════════════════════════════════════════════════╗"
        echo "║                    PROMPT VAULT QUALITY                        ║"
        echo "╚════════════════════════════════════════════════════════════════╝"
        echo ""

        total_templates=$(dolt sql -r csv -q "SELECT COUNT(*) FROM prompt_templates WHERE status = 'active'" | tail -1)
        total_skills=$(dolt sql -r csv -q "SELECT COUNT(*) FROM skills WHERE status = 'active'" | tail -1)
        total_executions=$(dolt sql -r csv -q "SELECT COUNT(*) FROM executions" | tail -1)
        total_feedback=$(dolt sql -r csv -q "SELECT COUNT(*) FROM feedback" | tail -1)
        captured_executions=$(dolt sql -r csv -q "SELECT COUNT(*) FROM executions WHERE output_text IS NOT NULL" | tail -1)
        private_captures=$(dolt sql -r csv -q "SELECT COUNT(*) FROM executions WHERE output_capture_mode = 'private' AND output_text IS NOT NULL" | tail -1)
        public_captures=$(dolt sql -r csv -q "SELECT COUNT(*) FROM executions WHERE output_capture_mode = 'public' AND output_text IS NOT NULL" | tail -1)
        capture_rate=$(dolt sql -r csv -q "SELECT ROUND(COUNT(*) * 100.0 / NULLIF((SELECT COUNT(*) FROM executions), 0), 1) FROM executions WHERE output_text IS NOT NULL" | tail -1)
        feedback_rate=$(dolt sql -r csv -q "SELECT ROUND(COUNT(*) * 100.0 / NULLIF((SELECT COUNT(*) FROM executions), 0), 1) FROM feedback" | tail -1)

        echo "Overview"
        echo "─────────────────────────────────────"
        printf "  Templates:    %4s   Skills:       %3s\n" "$total_templates" "$total_skills"
        printf "  Executions:   %4s   Feedback:     %3s\n" "$total_executions" "$total_feedback"
        echo ""
        echo "Evidence Coverage"
        echo "─────────────────────────────────────"
        printf "  Captured:     %4s   Capture rate: %6s%%\n" "$captured_executions" "${capture_rate:-0.0}"
        printf "  Private:      %4s   Public:       %3s\n" "$private_captures" "$public_captures"
        printf "  Feedback rate:%4s%%\n" "${feedback_rate:-0.0}"
        echo ""

        echo "Template Quality Scores"
        echo "─────────────────────────────────────"
        printf "%-25s %6s %6s\n" "NAME" "SCORE" "GRADE"
        echo "─────────────────────────────────────"

        dolt sql -r csv -q "SELECT name FROM prompt_templates WHERE status = 'active' ORDER BY name" | tail -n +2 | while read -r name; do
            [ -z "$name" ] && continue
            score=$(calculate_template_score "$name")
            grade=$(get_grade "$score")
            printf "%-25s %6s %6s\n" "$name" "$score" "$grade"
        done

        echo ""
        echo "Skill Quality Scores"
        echo "─────────────────────────────────────"
        printf "%-25s %6s %6s\n" "NAME" "SCORE" "GRADE"
        echo "─────────────────────────────────────"

        dolt sql -r csv -q "SELECT name FROM skills WHERE status = 'active' ORDER BY name" | tail -n +2 | while read -r name; do
            [ -z "$name" ] && continue
            score=$(calculate_skill_score "$name")
            grade=$(get_grade "$score")
            printf "%-25s %6s %6s\n" "$name" "$score" "$grade"
        done

        echo ""
        echo "Score Components: Description (0-20), Content (0-15), Usage (0-25), Ratings (0-40)"
        ;;

    check)
        template_count=$(dolt sql -r csv -q "SELECT COUNT(*) FROM prompt_templates WHERE status = 'active'" | tail -1)
        skill_count=$(dolt sql -r csv -q "SELECT COUNT(*) FROM skills WHERE status = 'active'" | tail -1)
        execution_count=$(dolt sql -r csv -q "SELECT COUNT(*) FROM executions" | tail -1)
        first_template=$(dolt sql -r csv -q "SELECT name FROM prompt_templates WHERE status = 'active' ORDER BY name LIMIT 1" | tail -1)

        if [ -n "$first_template" ]; then
            sample_score=$(calculate_template_score "$first_template")
            [[ "$sample_score" =~ ^[0-9]+$ ]] || {
                error "Computed non-numeric quality score for '$first_template'"
                exit 1
            }
        fi

        echo "Quality checks passed"
        echo "  Active templates: ${template_count:-0}"
        echo "  Active skills: ${skill_count:-0}"
        echo "  Executions: ${execution_count:-0}"
        [ -n "$first_template" ] && echo "  Sample score: $first_template -> $sample_score"
        ;;

    template)
        name="${1:-}"
        [ -z "$name" ] && { error "Usage: pv-quality template <name>"; exit 1; }
        escaped_name=$(require_active_template "$name")

        score=$(calculate_template_score "$name")
        grade=$(get_grade "$score")

        echo "=== $name Quality Score ==="
        echo ""
        echo "Score: $score/100"
        echo "Grade: $grade"
        echo ""

        dolt sql -q "
            SELECT 
                CHAR_LENGTH(content) as content_chars,
                CHAR_LENGTH(description) as desc_chars,
                (SELECT COUNT(*) FROM executions e WHERE e.entity_type = 'template' AND e.entity_id = t.id) as uses,
                (SELECT ROUND(AVG(rating), 2) FROM executions e JOIN feedback f ON f.execution_id = e.id WHERE e.entity_type = 'template' AND e.entity_id = t.id) as avg_rating
            FROM prompt_templates t
            WHERE name = '$escaped_name' AND status = 'active'
        " -r tabular
        echo ""
        echo "Evidence Coverage"
        dolt sql -q "
            SELECT
                COUNT(e.id) as executions,
                COUNT(f.id) as feedback_rows,
                SUM(CASE WHEN e.output_text IS NOT NULL THEN 1 ELSE 0 END) as captured_executions,
                SUM(CASE WHEN e.output_capture_mode = 'private' AND e.output_text IS NOT NULL THEN 1 ELSE 0 END) as private_captures,
                SUM(CASE WHEN e.output_capture_mode = 'public' AND e.output_text IS NOT NULL THEN 1 ELSE 0 END) as public_captures
            FROM prompt_templates t
            LEFT JOIN executions e ON e.entity_type = 'template' AND e.entity_id = t.id
            LEFT JOIN feedback f ON f.execution_id = e.id
            WHERE t.name = '$escaped_name' AND t.status = 'active'
        " -r tabular
        ;;

    skill)
        name="${1:-}"
        [ -z "$name" ] && { error "Usage: pv-quality skill <name>"; exit 1; }
        require_active_skill "$name" >/dev/null

        score=$(calculate_skill_score "$name")
        grade=$(get_grade "$score")

        echo "=== $name Quality Score ==="
        echo ""
        echo "Score: $score/100"
        echo "Grade: $grade"
        ;;

    report)
        output="${1:-quality-report.md}"

        echo "Generating quality report..."

        {
            echo "# Prompt Vault Quality Report"
            echo ""
            echo "Generated: $(date)"
            echo ""
            echo "## Summary"
            echo ""
            echo "- Templates: $(dolt sql -r csv -q "SELECT COUNT(*) FROM prompt_templates WHERE status = 'active'" | tail -1)"
            echo "- Skills: $(dolt sql -r csv -q "SELECT COUNT(*) FROM skills WHERE status = 'active'" | tail -1)"
            echo "- Executions: $(dolt sql -r csv -q "SELECT COUNT(*) FROM executions" | tail -1)"
            echo ""
            echo "## Template Scores"
            echo ""
            echo "| Name | Score | Grade |"
            echo "|------|-------|-------|"

            dolt sql -r csv -q "SELECT name FROM prompt_templates WHERE status = 'active' ORDER BY name" | tail -n +2 | while read -r name; do
                [ -z "$name" ] && continue
                score=$(calculate_template_score "$name")
                grade=$(get_grade "$score")
                echo "| $name | $score | $grade |"
            done

            echo ""
            echo "## Skill Scores"
            echo ""
            echo "| Name | Score | Grade |"
            echo "|------|-------|-------|"

            dolt sql -r csv -q "SELECT name FROM skills WHERE status = 'active' ORDER BY name" | tail -n +2 | while read -r name; do
                [ -z "$name" ] && continue
                score=$(calculate_skill_score "$name")
                grade=$(get_grade "$score")
                echo "| $name | $score | $grade |"
            done
        } > "$output"

        echo "✓ Report saved to $output"
        ;;

    low)
        threshold="${1:-60}"
        require_numeric "$threshold" "threshold"
        echo "=== Items Below $threshold Points ==="
        echo ""

        dolt sql -r csv -q "SELECT name FROM prompt_templates WHERE status = 'active'" | tail -n +2 | while read -r name; do
            [ -z "$name" ] && continue
            score=$(calculate_template_score "$name")
            if [ "$score" -lt "$threshold" ]; then
                echo "  Template: $name ($score pts)"
            fi
        done

        dolt sql -r csv -q "SELECT name FROM skills WHERE status = 'active'" | tail -n +2 | while read -r name; do
            [ -z "$name" ] && continue
            score=$(calculate_skill_score "$name")
            if [ "$score" -lt "$threshold" ]; then
                echo "  Skill: $name ($score pts)"
            fi
        done
        ;;

    help|-h|--help)
        usage
        ;;

    *)
        error "Unknown command: $cmd"
        usage >&2
        exit 1
        ;;
esac
