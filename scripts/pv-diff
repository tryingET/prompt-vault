#!/usr/bin/env bash
# pv-diff - Enhanced diff visualization
# Usage: pv-diff <from> <to> [options]
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VAULT_DIR="${VAULT_DIR:-$SCRIPT_DIR/../prompt-vault-db}"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/pv-lib.sh"

from="${1:-HEAD~1}"
to="${2:-HEAD}"
type="${3:-all}"

# Colors
CYAN='\033[0;36m'
NC='\033[0m'

show_table_diff() {
    local table="$1"
    echo -e "${CYAN}=== $table ===${NC}"
    dolt diff "$from" "$to" "$table" 2>/dev/null | head -50
    echo ""
}

show_template_diff() {
    local name="$1"
    local escaped_name escaped_from escaped_to
    local from_content to_content

    escaped_name=$(sql_escape "$name")
    escaped_from=$(sql_escape "$from")
    escaped_to=$(sql_escape "$to")

    echo -e "${CYAN}Template: $name${NC}"
    echo ""

    from_content=$(json_first_field "SELECT content FROM prompt_templates AS OF '$escaped_from' WHERE name = '$escaped_name' ORDER BY version DESC LIMIT 1" content)
    to_content=$(json_first_field "SELECT content FROM prompt_templates AS OF '$escaped_to' WHERE name = '$escaped_name' ORDER BY version DESC LIMIT 1" content)

    if [ -n "$from_content" ] && [ -n "$to_content" ]; then
        diff -u <(printf '%s\n' "$from_content") <(printf '%s\n' "$to_content") 2>/dev/null | head -100 || echo "(no changes)"
    else
        echo "Template not found in one of the requested refs"
    fi
    echo ""
}

case "$type" in
    all)
        ensure_vault

        echo -e "${CYAN}Prompt Vault Diff: $from..$to${NC}"
        echo ""

        echo "From commit:"
        dolt log -n 1 "$from" 2>/dev/null | head -6
        echo ""
        echo "To commit:"
        dolt log -n 1 "$to" 2>/dev/null | head -6
        echo ""

        for table in prompt_templates skills collections executions feedback; do
            if dolt diff "$from" "$to" "$table" 2>/dev/null | grep -q .; then
                show_table_diff "$table"
            fi
        done
        ;;

    templates)
        ensure_vault
        show_table_diff "prompt_templates"
        ;;

    skills)
        ensure_vault
        show_table_diff "skills"
        ;;

    template)
        ensure_vault
        name="${4:-}"
        [ -z "$name" ] && { echo "Usage: pv-diff <from> <to> template <name>" >&2; exit 1; }
        show_template_diff "$name"
        ;;

    stats)
        ensure_vault

        echo -e "${CYAN}Diff Statistics: $from..$to${NC}"
        echo ""
        dolt diff --stat "$from" "$to" 2>/dev/null
        ;;

    summary)
        ensure_vault

        echo -e "${CYAN}Summary: $from..$to${NC}"
        echo ""

        template_changes=$( (dolt diff "$from" "$to" prompt_templates 2>/dev/null | grep -c '^---\|^+++') || true )
        skill_changes=$( (dolt diff "$from" "$to" skills 2>/dev/null | grep -c '^---\|^+++') || true )
        template_changes=${template_changes:-0}
        skill_changes=${skill_changes:-0}

        echo "Changes:"
        echo "  Templates: $template_changes modifications"
        echo "  Skills: $skill_changes modifications"
        echo ""

        echo "Modified templates:"
        dolt diff "$from" "$to" prompt_templates 2>/dev/null | grep -E 'name.*\|' | head -10 || echo "  (none)"
        echo ""
        echo "Modified skills:"
        dolt diff "$from" "$to" skills 2>/dev/null | grep -E 'name.*\|' | head -10 || echo "  (none)"
        ;;

    json)
        ensure_vault

        echo "{"
        echo "  \"from\": \"$from\"," 
        echo "  \"to\": \"$to\"," 
        echo "  \"tables\": {"

        first=true
        for table in prompt_templates skills collections; do
            if dolt diff "$from" "$to" "$table" 2>/dev/null | grep -q .; then
                [ "$first" = false ] && echo ","
                first=false
                echo -n "    \"$table\": \"changed\""
            fi
        done

        echo ""
        echo "  }"
        echo "}"
        ;;

    help|*)
        cat << 'EOF'
Usage: pv-diff <from> <to> [type]

Compare two versions of the vault.

Types:
  all           Show all table diffs (default)
  templates     Show prompt_templates diff only
  skills        Show skills diff only
  template <n>  Show specific template diff
  stats         Show diff statistics
  summary       Show summary of changes
  json          Output as JSON

Examples:
  pv-diff HEAD~1 HEAD           # Last commit vs current
  pv-diff main experiment/x     # Compare branches
  pv-diff HEAD~5 HEAD summary   # Summary of last 5 commits
  pv-diff HEAD~1 HEAD template preflight  # Specific template
EOF
        ;;
esac
