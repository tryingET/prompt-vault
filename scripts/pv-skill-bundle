#!/usr/bin/env bash
# Exact source-owned skill snapshots; no bulk prompt import/export or implicit commits.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/pv-lib.sh"
ensure_vault
VAULT_DIR="$PWD"
export VAULT_DIR PYTHONDONTWRITEBYTECODE=1
exec python3 "$SCRIPT_DIR/pv_skill_cli.py" "$@"
