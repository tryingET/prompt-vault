#!/usr/bin/env bash
# pv-integrate - Integration helpers for external tools
# Usage: pv-integrate <command> [args]
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VAULT_DIR="${VAULT_DIR:-$SCRIPT_DIR/../prompt-vault-db}"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/pv-lib.sh"

cmd="${1:-help}"
shift || true

template_rows_sql="SELECT name, description, content, artifact_kind, control_mode, formalization_level, owner_company, visibility_companies, controlled_vocabulary FROM prompt_templates WHERE status = 'active' ORDER BY name"
skill_rows_sql="SELECT name, description, readme FROM skills WHERE status = 'active' ORDER BY name"
collection_rows_sql="SELECT name, description FROM collections ORDER BY name"

case "$cmd" in
    langchain)
        ensure_vault
        check_deps jq

        output="${1:-./langchain-prompts.json}"
        echo "Exporting for LangChain..."

        dolt_json_query "$template_rows_sql" | jq '
            .rows
            | map({
                name,
                template: .content,
                metadata: {
                    description,
                    artifact_kind,
                    control_mode,
                    formalization_level,
                    owner_company,
                    visibility_companies,
                    controlled_vocabulary
                }
            })
        ' > "$output"

        echo "✓ Exported to $output"
        ;;

    openai-functions)
        ensure_vault
        check_deps jq

        output="${1:-./openai-functions.json}"
        echo "Exporting as OpenAI function definitions..."

        dolt_json_query "$template_rows_sql" | jq '
            .rows
            | map({
                name,
                description,
                parameters: {
                    type: "object",
                    properties: {
                        args: {
                            type: "string",
                            description: "Arguments for the prompt"
                        }
                    },
                    required: ["args"]
                }
            })
        ' > "$output"

        echo "✓ Exported to $output"
        ;;

    semantic-kernel)
        ensure_vault
        check_deps jq

        output_dir="${1:-./semantic-kernel}"
        echo "Exporting for Semantic Kernel..."

        mkdir -p "$output_dir"

        while IFS= read -r row_b64; do
            [ -z "$row_b64" ] && continue
            row_json=$(json_decode_base64 "$row_b64")
            name=$(printf '%s' "$row_json" | jq -r '.name')
            desc=$(printf '%s' "$row_json" | jq -r '.description // ""')
            content=$(printf '%s' "$row_json" | jq -r '.content // ""')

            cat > "$output_dir/${name}.txt" << EOF
---
name: $name
description: $desc
---
$content
EOF
        done < <(json_rows_base64 "SELECT name, description, content FROM prompt_templates WHERE status = 'active' ORDER BY name")

        echo "✓ Exported to $output_dir/"
        ;;

    embeddings)
        ensure_vault
        check_deps jq

        output="${1:-./embeddings.jsonl}"
        echo "Generating embeddings-ready content..."

        {
            dolt_json_query "SELECT name, description, content FROM prompt_templates WHERE status = 'active' ORDER BY name" | jq -cr '
                .rows[]
                | {
                    id: ("template-" + .name),
                    text: ("Template: " + .name + ". " + (.description // "") + ". " + (.content // "")),
                    metadata: {type: "template", name: .name}
                }
            '
            dolt_json_query "$skill_rows_sql" | jq -cr '
                .rows[]
                | {
                    id: ("skill-" + .name),
                    text: ("Skill: " + .name + ". " + (.description // "") + ". " + (.readme // "")),
                    metadata: {type: "skill", name: .name}
                }
            '
        } > "$output"

        echo "✓ Generated $(wc -l < "$output") embedding records in $output"
        ;;

    obsidian)
        ensure_vault
        check_deps jq

        output_dir="${1:-./obsidian-vault}"
        echo "Creating Obsidian vault..."

        mkdir -p "$output_dir/Templates" "$output_dir/Skills" "$output_dir/Collections"

        while IFS= read -r row_b64; do
            [ -z "$row_b64" ] && continue
            row_json=$(json_decode_base64 "$row_b64")
            name=$(printf '%s' "$row_json" | jq -r '.name')
            desc=$(printf '%s' "$row_json" | jq -r '.description // ""')
            content=$(printf '%s' "$row_json" | jq -r '.content // ""')

            cat > "$output_dir/Templates/${name}.md" << EOF
---
type: prompt-template
description: $desc
---

# $name

$desc

## Prompt

\`\`\`markdown
$content
\`\`\`
EOF
        done < <(json_rows_base64 "SELECT name, description, content FROM prompt_templates WHERE status = 'active' ORDER BY name")

        while IFS= read -r row_b64; do
            [ -z "$row_b64" ] && continue
            row_json=$(json_decode_base64 "$row_b64")
            name=$(printf '%s' "$row_json" | jq -r '.name')
            readme=$(printf '%s' "$row_json" | jq -r '.readme // ""')

            cat > "$output_dir/Skills/${name}.md" << EOF
---
type: skill
---

$readme
EOF
        done < <(json_rows_base64 "$skill_rows_sql")

        while IFS= read -r row_b64; do
            [ -z "$row_b64" ] && continue
            row_json=$(json_decode_base64 "$row_b64")
            name=$(printf '%s' "$row_json" | jq -r '.name')
            desc=$(printf '%s' "$row_json" | jq -r '.description // ""')

            cat > "$output_dir/Collections/${name}.md" << EOF
---
type: collection
---

# $name

$desc

## Templates

\`\`\`dataview
LIST
FROM "Templates"
WHERE contains(collection, "$name")
\`\`\`
EOF
        done < <(json_rows_base64 "$collection_rows_sql")

        echo "✓ Created Obsidian vault at $output_dir/"
        ;;

    api-server)
        ensure_vault
        check_deps python3

        port="${1:-8080}"
        require_numeric "$port" "port"
        visibility_company="${PV_API_VISIBILITY_COMPANY:-${VISIBILITY_COMPANY:-core}}"
        case "$visibility_company" in
            core|software|finance|house|health|teaching|holding) ;;
            *)
                error "PV_API_VISIBILITY_COMPANY must be one of: core software finance house health teaching holding"
                exit 1
                ;;
        esac

        echo "Starting REST API server on port $port for visibility company '$visibility_company'..."

        make_temp_file api_script .py

        cat > "$api_script" << 'PYEOF'
#!/usr/bin/env python3
import json
import os
import subprocess
from http.server import HTTPServer, BaseHTTPRequestHandler
from urllib.parse import parse_qs, unquote, urlparse

VAULT_DIR = os.environ.get('VAULT_DIR', './prompt-vault-db')
PORT = int(os.environ.get('PORT', '8080'))
VISIBILITY_COMPANY = os.environ.get('PV_API_VISIBILITY_COMPANY', os.environ.get('VISIBILITY_COMPANY', 'core'))
ALLOWED_COMPANIES = {'core', 'software', 'finance', 'house', 'health', 'teaching', 'holding'}

if VISIBILITY_COMPANY not in ALLOWED_COMPANIES:
    raise SystemExit(f"invalid PV_API_VISIBILITY_COMPANY: {VISIBILITY_COMPANY}")


def sql_quote(value: str) -> str:
    return value.replace('\\', '\\\\').replace("'", "''")


def visibility_clause(alias: str) -> str:
    company = sql_quote(VISIBILITY_COMPANY)
    return (
        f"({alias}.owner_company = '{company}' "
        f"OR JSON_CONTAINS({alias}.visibility_companies, JSON_QUOTE('{company}')))"
    )


def run_sql_json(query: str):
    result = subprocess.run(
        ['dolt', 'sql', '-q', query, '-r', 'json'],
        capture_output=True,
        text=True,
        cwd=VAULT_DIR,
    )
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip() or 'dolt sql failed')
    payload = result.stdout.strip() or '{"rows": []}'
    return json.loads(payload).get('rows', [])


def template_rows(full: bool = False):
    fields = '*'
    if not full:
        fields = 'name, description, status, owner_company, visibility_companies'
    query = (
        f"SELECT {fields} FROM prompt_templates "
        f"WHERE status = 'active' AND {visibility_clause('prompt_templates')} ORDER BY name"
    )
    return run_sql_json(query)


def skill_rows(full: bool = False):
    fields = '*'
    if not full:
        fields = 'name, description, status, owner_company, visibility_companies'
    query = (
        f"SELECT {fields} FROM skills "
        f"WHERE status = 'active' AND {visibility_clause('skills')} ORDER BY name"
    )
    return run_sql_json(query)


def visible_execution_count() -> int:
    query = f'''
        SELECT COUNT(*) AS executions
        FROM executions e
        LEFT JOIN prompt_templates t
          ON e.entity_type = 'template' AND e.entity_id = t.id
        LEFT JOIN skills s
          ON e.entity_type = 'skill' AND e.entity_id = s.id
        WHERE (
            e.entity_type = 'template'
            AND t.status = 'active'
            AND {visibility_clause('t')}
        ) OR (
            e.entity_type = 'skill'
            AND s.status = 'active'
            AND {visibility_clause('s')}
        )
    '''
    rows = run_sql_json(query)
    return rows[0].get('executions', 0) if rows else 0


class VaultHandler(BaseHTTPRequestHandler):
    def send_json(self, status_code: int, payload):
        body = json.dumps(payload).encode()
        self.send_response(status_code)
        self.send_header('Content-Type', 'application/json')
        self.send_header('Content-Length', str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        try:
            parsed = urlparse(self.path)
            path = parsed.path
            query = parse_qs(parsed.query)

            if path == '/api/templates':
                rows = template_rows(full=False)
                search = query.get('search', [''])[0].strip().lower()
                if search:
                    rows = [
                        row for row in rows
                        if search in ((row.get('name') or '') + ' ' + (row.get('description') or '')).lower()
                    ]
                self.send_json(200, {'rows': rows})
                return

            if path.startswith('/api/templates/'):
                name = unquote(path.split('/')[-1])
                rows = [row for row in template_rows(full=True) if row.get('name') == name]
                self.send_json(200, {'rows': rows[:1]})
                return

            if path == '/api/skills':
                self.send_json(200, {'rows': skill_rows(full=False)})
                return

            if path.startswith('/api/skills/'):
                name = unquote(path.split('/')[-1])
                rows = [row for row in skill_rows(full=True) if row.get('name') == name]
                self.send_json(200, {'rows': rows[:1]})
                return

            if path == '/api/stats':
                templates = template_rows(full=False)
                skills = skill_rows(full=False)
                self.send_json(200, {
                    'rows': [{
                        'templates': len(templates),
                        'skills': len(skills),
                        'executions': visible_execution_count(),
                        'visibility_company': VISIBILITY_COMPANY,
                    }]
                })
                return

            if path == '/health':
                self.send_json(200, {'status': 'ok', 'visibility_company': VISIBILITY_COMPANY})
                return

            self.send_json(404, {'error': 'not found'})
        except Exception as exc:  # pragma: no cover - defensive runtime surface
            self.send_json(500, {'error': str(exc)})

    def log_message(self, format, *args):
        print(f"[API] {args[0]}")


if __name__ == '__main__':
    server = HTTPServer(('', PORT), VaultHandler)
    print(f"Prompt Vault API running on port {PORT}")
    print(f"Visibility company: {VISIBILITY_COMPANY}")
    print('Endpoints: /api/templates, /api/skills, /api/stats, /health')
    server.serve_forever()
PYEOF

        export VAULT_DIR="$VAULT_DIR"
        export PORT="$port"
        export PV_API_VISIBILITY_COMPANY="$visibility_company"
        python3 "$api_script"
        ;;

    webhook)
        ensure_vault

        event="${1:-push}"
        echo "Processing webhook event: $event"

        case "$event" in
            push)
                echo "Pulling latest changes..."
                dolt pull origin main 2>/dev/null || echo "No remote configured"

                echo "Exporting to pi format..."
                export VAULT_DIR
                "$SCRIPT_DIR/export-to-pi.sh"
                ;;
            import)
                echo "Importing from pi format..."
                export VAULT_DIR
                "$SCRIPT_DIR/import-from-pi.sh"
                ;;
            backup)
                export VAULT_DIR
                "$SCRIPT_DIR/pv-backup" create
                ;;
        esac
        ;;

    help|*)
        cat << 'EOF'
Usage: pv-integrate <command> [args]

Export Formats:
  langchain [output]      Export for LangChain (JSON)
  openai-functions [out]  Export as OpenAI function definitions
  semantic-kernel [dir]   Export for Semantic Kernel
  embeddings [output]     Generate embedding-ready JSONL
  obsidian [dir]          Create Obsidian vault

Integration:
  api-server [port]       Start REST API server (port 8080, governed by PV_API_VISIBILITY_COMPANY)
  webhook <event>         Process webhook (push, import, backup)

Examples:
  pv-integrate langchain ./prompts.json
  pv-integrate obsidian ~/Notes/Prompts
  PV_API_VISIBILITY_COMPANY=software pv-integrate api-server 3000
  pv-integrate embeddings | openai embeddings create -
EOF
        ;;
esac
