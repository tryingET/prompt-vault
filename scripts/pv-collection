#!/usr/bin/env bash
# pv-collection - Manage prompt collections
# Usage: pv-collection <command> [args]
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VAULT_DIR="${VAULT_DIR:-$SCRIPT_DIR/../prompt-vault-db}"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/pv-lib.sh"

ensure_vault
check_deps jq

cmd="${1:-list}"
shift || true

case "$cmd" in
    list)
        echo "=== Collections ==="
        dolt sql -q "
            SELECT 
                c.name,
                c.description,
                JSON_LENGTH(c.template_ids) as templates,
                JSON_LENGTH(c.skill_ids) as skills
            FROM collections c
            ORDER BY c.name
        " -r tabular
        ;;

    create)
        name="${1:-}"
        [ -z "$name" ] && { echo "Usage: pv-collection create <name> [description]" >&2; exit 1; }
        desc="${2:-}"
        escaped_name=$(sql_escape "$name")
        escaped_desc=$(sql_escape "$desc")

        dolt sql -q "
            INSERT INTO collections (name, description, template_ids, skill_ids)
            VALUES ('$escaped_name', '$escaped_desc', '[]', '[]')
        "
        echo "✓ Created collection: $name"
        echo "Add items: pv-collection add-template $name <template>"
        ;;

    delete)
        name="${1:-}"
        [ -z "$name" ] && { echo "Usage: pv-collection delete <name>" >&2; exit 1; }
        escaped_name=$(sql_escape "$name")

        dolt sql -q "DELETE FROM collections WHERE name = '$escaped_name'"
        echo "✓ Deleted collection: $name"
        ;;

    add-template)
        name="${1:-}"
        template="${2:-}"
        [ -z "$name" ] || [ -z "$template" ] && {
            echo "Usage: pv-collection add-template <collection> <template>" >&2
            exit 1
        }

        escaped_name=$(sql_escape "$name")
        escaped_template=$(sql_escape "$template")
        TID=$(dolt sql -r csv -q "
            SELECT id FROM prompt_templates 
            WHERE name = '$escaped_template' AND status = 'active' 
            ORDER BY version DESC LIMIT 1
        " | tail -1)

        if [ -z "$TID" ]; then
            echo "Error: Template '$template' not found" >&2
            exit 1
        fi

        dolt sql -q "
            UPDATE collections 
            SET template_ids = JSON_ARRAY_APPEND(template_ids, '\$', $TID)
            WHERE name = '$escaped_name'
        "
        echo "✓ Added template '$template' to collection '$name'"
        ;;

    add-skill)
        name="${1:-}"
        skill="${2:-}"
        [ -z "$name" ] || [ -z "$skill" ] && {
            echo "Usage: pv-collection add-skill <collection> <skill>" >&2
            exit 1
        }

        escaped_name=$(sql_escape "$name")
        escaped_skill=$(sql_escape "$skill")
        SID=$(dolt sql -r csv -q "
            SELECT id FROM skills 
            WHERE name = '$escaped_skill' AND status = 'active' 
            ORDER BY version DESC LIMIT 1
        " | tail -1)

        if [ -z "$SID" ]; then
            echo "Error: Skill '$skill' not found" >&2
            exit 1
        fi

        dolt sql -q "
            UPDATE collections 
            SET skill_ids = JSON_ARRAY_APPEND(skill_ids, '\$', $SID)
            WHERE name = '$escaped_name'
        "
        echo "✓ Added skill '$skill' to collection '$name'"
        ;;

    remove-template)
        name="${1:-}"
        template="${2:-}"
        [ -z "$name" ] || [ -z "$template" ] && {
            echo "Usage: pv-collection remove-template <collection> <template>" >&2
            exit 1
        }

        escaped_name=$(sql_escape "$name")
        escaped_template=$(sql_escape "$template")
        TID=$(dolt sql -r csv -q "SELECT id FROM prompt_templates WHERE name = '$escaped_template' LIMIT 1" | tail -1)
        CURRENT=$(json_first_field "SELECT template_ids FROM collections WHERE name = '$escaped_name'" template_ids)
        NEW=$(printf '%s' "$CURRENT" | jq --argjson id "$TID" 'map(select(. != $id))')
        escaped_new=$(sql_escape "$NEW")

        dolt sql -q "UPDATE collections SET template_ids = '$escaped_new' WHERE name = '$escaped_name'"
        echo "✓ Removed template '$template' from collection '$name'"
        ;;

    show)
        name="${1:-}"
        [ -z "$name" ] && { echo "Usage: pv-collection show <name>" >&2; exit 1; }
        escaped_name=$(sql_escape "$name")

        echo "=== Collection: $name ==="
        dolt sql -q "SELECT name, description FROM collections WHERE name = '$escaped_name'" -r tabular

        echo ""
        echo "Templates:"
        dolt sql -q "
            SELECT t.name, t.description, t.status
            FROM prompt_templates t
            JOIN collections c ON JSON_CONTAINS(c.template_ids, CAST(t.id AS CHAR))
            WHERE c.name = '$escaped_name'
        " -r tabular

        echo ""
        echo "Skills:"
        dolt sql -q "
            SELECT s.name, s.description, s.status
            FROM skills s
            JOIN collections c ON JSON_CONTAINS(c.skill_ids, CAST(s.id AS CHAR))
            WHERE c.name = '$escaped_name'
        " -r tabular
        ;;

    export)
        name="${1:-}"
        [ -z "$name" ] && { echo "Usage: pv-collection export <name>" >&2; exit 1; }
        escaped_name=$(sql_escape "$name")

        output_dir="${2:-./${name}-export}"
        mkdir -p "$output_dir/prompts" "$output_dir/skills"

        while IFS= read -r row_b64; do
            [ -z "$row_b64" ] && continue
            row_json=$(json_decode_base64 "$row_b64")
            tname=$(printf '%s' "$row_json" | jq -r '.name')
            content=$(printf '%s' "$row_json" | jq -r '.content // ""')
            printf '%s\n' "$content" > "$output_dir/prompts/${tname}.md"
        done < <(json_rows_base64 "
            SELECT t.name, t.content
            FROM prompt_templates t
            JOIN collections c ON JSON_CONTAINS(c.template_ids, CAST(t.id AS CHAR))
            WHERE c.name = '$escaped_name' AND t.status = 'active'
            ORDER BY t.name
        ")

        while IFS= read -r row_b64; do
            [ -z "$row_b64" ] && continue
            row_json=$(json_decode_base64 "$row_b64")
            sname=$(printf '%s' "$row_json" | jq -r '.name')
            readme=$(printf '%s' "$row_json" | jq -r '.readme // ""')
            mkdir -p "$output_dir/skills/$sname"
            printf '%s\n' "$readme" > "$output_dir/skills/$sname/SKILL.md"
        done < <(json_rows_base64 "
            SELECT s.name, s.readme
            FROM skills s
            JOIN collections c ON JSON_CONTAINS(c.skill_ids, CAST(s.id AS CHAR))
            WHERE c.name = '$escaped_name' AND s.status = 'active'
            ORDER BY s.name
        ")

        echo "✓ Exported collection '$name' to $output_dir"
        ;;

    *)
        echo "Unknown command: $cmd" >&2
        cat >&2 << 'EOF'
Usage: pv-collection <command> [args]

Commands:
  list                           List all collections
  create <name> [desc]           Create new collection
  delete <name>                  Delete collection
  add-template <c> <template>    Add template to collection
  add-skill <c> <skill>          Add skill to collection
  remove-template <c> <template> Remove template from collection
  show <name>                    Show collection contents
  export <name> [dir]            Export collection to files
EOF
        exit 1
        ;;
esac
