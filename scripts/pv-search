#!/usr/bin/env bash
# pv-search - Search templates and skills
# Usage: pv-search <query> [--type template|skill|all]
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck disable=SC1091
source "$SCRIPT_DIR/pv-lib.sh"

SEARCH_USAGE="pv-search <query> [--type template|skill|all]"

ensure_vault

query="${1:-}"
if [ -z "$query" ]; then
    usage_error "$SEARCH_USAGE"
fi
shift || true

type="all"
while [[ $# -gt 0 ]]; do
    case "$1" in
        --type|-t)
            require_option_value "$1" "${2-}" "$SEARCH_USAGE"
            require_allowed_value "search type" "$2" "$SEARCH_USAGE" template skill all
            type="$2"
            shift 2
            ;;
        *)
            usage_error "$SEARCH_USAGE" "Unknown argument: $1"
            ;;
    esac
done

query_escaped=$(sql_escape "$query")

echo "=== Search Results: '$query' ==="

search_templates() {
    dolt sql -q "
        SELECT 
            'template' as type,
            name,
            description,
            status,
            MATCH(content, description) AGAINST ('$query_escaped') as relevance
        FROM prompt_templates
        WHERE 
            (content LIKE '%$query_escaped%' OR description LIKE '%$query_escaped%' OR name LIKE '%$query_escaped%')
            AND status != 'archived'
        ORDER BY relevance DESC, name
    " -r tabular 2>/dev/null || dolt sql -q "
        SELECT 
            'template' as type,
            name,
            description,
            status
        FROM prompt_templates
        WHERE 
            (content LIKE '%$query_escaped%' OR description LIKE '%$query_escaped%' OR name LIKE '%$query_escaped%')
            AND status != 'archived'
        ORDER BY name
    " -r tabular
}

search_skills() {
    dolt sql -q "
        SELECT 
            'skill' as type,
            name,
            LEFT(description, 60) as description,
            status
        FROM skills
        WHERE 
            (readme LIKE '%$query_escaped%' OR description LIKE '%$query_escaped%' OR name LIKE '%$query_escaped%')
            AND status != 'archived'
        ORDER BY name
    " -r tabular
}

case "$type" in
    template)
        search_templates
        ;;
    skill)
        search_skills
        ;;
    all)
        echo "Templates:"
        search_templates
        echo ""
        echo "Skills:"
        search_skills
        ;;
esac

echo ""
echo "Show details: pv show <type> <name>"
