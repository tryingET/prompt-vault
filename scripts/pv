#!/usr/bin/env bash
# pv - Prompt Vault CLI
# Unified interface for managing versioned prompt templates and skills
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VERSION="1.0.0"

# Source shared library
# shellcheck disable=SC1091
source "$SCRIPT_DIR/pv-lib.sh"

cmd_init() {
    export VAULT_DIR
    "$SCRIPT_DIR/init-vault.sh" "$@"
}

cmd_import() {
    ensure_vault
    export VAULT_DIR
    "$SCRIPT_DIR/import-from-pi.sh" "$@"
}

cmd_export() {
    ensure_vault
    export VAULT_DIR
    "$SCRIPT_DIR/export-to-pi.sh" "$@"
}

cmd_templates() {
    ensure_vault
    local facet_filter="${1:-}"
    local where=""

    if [ -n "$facet_filter" ]; then
        if [[ "$facet_filter" == *=* ]]; then
            local facet_name="${facet_filter%%=*}"
            local facet_value="${facet_filter#*=}"
            local escaped_value
            escaped_value=$(sql_escape "$facet_value")
            if [ "$facet_name" = "export_to_pi" ]; then
                case "$facet_value" in
                    true|TRUE|1) where="WHERE export_to_pi = TRUE" ;;
                    false|FALSE|0) where="WHERE export_to_pi = FALSE" ;;
                    *) error "export_to_pi filter must be true/false"; exit 1 ;;
                esac
            elif [ "$facet_name" = "visibility_company" ]; then
                where="WHERE JSON_SEARCH(visibility_companies, 'one', '$escaped_value') IS NOT NULL"
            elif [[ "$facet_name" == cv.* ]]; then
                local cv_key="${facet_name#cv.}"
                case "$cv_key" in
                    routing_context|activity_phase|input_artifact|transition_target_type|selection_principles|output_commitment) ;;
                    *) error "Unsupported controlled vocabulary filter: $cv_key"; exit 1 ;;
                esac
                if [ "$cv_key" = "selection_principles" ]; then
                    where="WHERE JSON_SEARCH(controlled_vocabulary, 'one', '$escaped_value', NULL, '$.selection_principles[*]') IS NOT NULL"
                else
                    where="WHERE JSON_UNQUOTE(JSON_EXTRACT(controlled_vocabulary, '$.${cv_key}')) = '$escaped_value'"
                fi
            else
                case "$facet_name" in
                    artifact_kind|control_mode|formalization_level|owner_company|status) ;;
                    *) error "Unsupported template filter field: $facet_name"; exit 1 ;;
                esac
                where="WHERE ${facet_name} = '$escaped_value'"
            fi
        else
            local escaped_filter
            escaped_filter=$(sql_escape "$facet_filter")
            where="WHERE artifact_kind = '$escaped_filter' OR control_mode = '$escaped_filter' OR formalization_level = '$escaped_filter'"
        fi
        echo "=== Prompt Templates ($facet_filter) ==="
    else
        echo "=== Prompt Templates ==="
    fi

    dolt sql -q "
        SELECT name, owner_company, artifact_kind, control_mode, formalization_level,
               JSON_UNQUOTE(JSON_EXTRACT(controlled_vocabulary, '$.routing_context')) AS routing_context,
               JSON_UNQUOTE(JSON_EXTRACT(controlled_vocabulary, '$.activity_phase')) AS activity_phase,
               JSON_UNQUOTE(JSON_EXTRACT(controlled_vocabulary, '$.transition_target_type')) AS transition_target_type,
               status, export_to_pi, version
        FROM prompt_templates
        $where
        ORDER BY artifact_kind, control_mode, formalization_level, name
    " -r tabular
}

cmd_skills() {
    ensure_vault
    echo "=== Skills ==="
    dolt sql -q "
        SELECT name, owner_company, description, status, version 
        FROM skills 
        ORDER BY name
    " -r tabular
}

cmd_new_template() {
    ensure_vault
    local name="${1:-}"
    [ -z "$name" ] && { error "Usage: pv new-template <name>"; exit 1; }

    info "Creating template: $name"

    echo -n "Description: "
    read -r description

    echo -n "Artifact kind [procedure]: "
    read -r artifact_kind
    artifact_kind=${artifact_kind:-procedure}

    echo -n "Control mode [one_shot]: "
    read -r control_mode
    control_mode=${control_mode:-one_shot}

    echo -n "Formalization level [structured]: "
    read -r formalization_level
    formalization_level=${formalization_level:-structured}

    echo -n "Owner company [core]: "
    read -r owner_company
    owner_company=${owner_company:-core}

    echo -n "Visibility companies (comma-separated) [core,software,finance,house,health,teaching,holding]: "
    read -r visibility_companies_csv
    visibility_companies_csv=${visibility_companies_csv:-core,software,finance,house,health,teaching,holding}

    local visibility_companies_json
    visibility_companies_json=$(json_array_from_csv "$visibility_companies_csv")

    local controlled_vocabulary_json=""
    if [ "$control_mode" = "router" ]; then
        local routing_context activity_phase input_artifact transition_target_type selection_principles_csv output_commitment

        echo -n "Routing context [analysis_followup]: "
        read -r routing_context
        routing_context=${routing_context:-analysis_followup}

        echo -n "Activity phase [post_analysis]: "
        read -r activity_phase
        activity_phase=${activity_phase:-post_analysis}

        echo -n "Input artifact [analysis_output]: "
        read -r input_artifact
        input_artifact=${input_artifact:-analysis_output}

        echo -n "Transition target type [framework_mode]: "
        read -r transition_target_type
        transition_target_type=${transition_target_type:-framework_mode}

        echo -n "Selection principles (comma-separated) [evidence_based]: "
        read -r selection_principles_csv
        selection_principles_csv=${selection_principles_csv:-evidence_based}

        echo -n "Output commitment [exact_next_prompt]: "
        read -r output_commitment
        output_commitment=${output_commitment:-exact_next_prompt}

        controlled_vocabulary_json=$(python3 - <<PY
import json
items = [item.strip() for item in """$selection_principles_csv""".split(",") if item.strip()]
print(json.dumps({
  "routing_context": """$routing_context""".strip(),
  "activity_phase": """$activity_phase""".strip(),
  "input_artifact": """$input_artifact""".strip(),
  "transition_target_type": """$transition_target_type""".strip(),
  "selection_principles": items,
  "output_commitment": """$output_commitment""".strip(),
}))
PY
)
    fi

    echo "Content (Ctrl+D to finish):"
    content=$(cat)

    create_template_entity "$name" "$description" "$content" "$artifact_kind" "$control_mode" "$formalization_level" "$owner_company" "$visibility_companies_json" "$controlled_vocabulary_json" draft

    success "Created template '$name' (draft)"
    info "Edit with: pv edit-template $name"
    info "Activate with: pv activate template $name"
}

refresh_pi_projection_after_template_change() {
    local name="${1:-}"
    local reason="${2:-template change}"
    local force="${3:-false}"
    local escaped_name status export_enabled should_refresh

    [ -z "$name" ] && return 0

    escaped_name=$(sql_escape "$name")
    status=$(json_first_field "SELECT status FROM prompt_templates WHERE name = '$escaped_name' LIMIT 1" status)
    export_enabled=$(json_first_field "SELECT export_to_pi FROM prompt_templates WHERE name = '$escaped_name' LIMIT 1" export_to_pi)
    case "$export_enabled" in
        1|true|TRUE) export_enabled="true" ;;
        0|false|FALSE|"") export_enabled="false" ;;
    esac

    should_refresh="$force"
    if [ "$status" = "active" ] && [ "$export_enabled" = "true" ]; then
        should_refresh="true"
    fi

    [ "$should_refresh" = "true" ] || return 0

    if [ "${PV_AUTO_EXPORT:-1}" = "0" ]; then
        if ! "$SCRIPT_DIR/pv-export-freshness" --quiet; then
            error "Pi projection is stale after $reason for '$name'"
            error "Run: ./scripts/pv export"
            exit 1
        fi
        return 0
    fi

    info "Refreshing Pi prompt projection after $reason for '$name'"
    cmd_export >/dev/null
    "$SCRIPT_DIR/pv-export-freshness" --quiet
    success "Pi prompt projection fresh"
}

cmd_new_skill() {
    ensure_vault
    local name="${1:-}"
    [ -z "$name" ] && { error "Usage: pv new-skill <name>"; exit 1; }
    
    info "Creating skill: $name"
    
    echo -n "Description: "
    read -r description
    
    echo -n "License [MIT]: "
    read -r license
    license=${license:-MIT}
    
    echo -n "Compatibility: "
    read -r compatibility

    echo -n "Owner company [core]: "
    read -r owner_company
    owner_company=${owner_company:-core}

    echo -n "Visibility companies (comma-separated) [core,software,finance,house,health,teaching,holding]: "
    read -r visibility_companies_csv
    visibility_companies_csv=${visibility_companies_csv:-core,software,finance,house,health,teaching,holding}
    
    echo "README content (Ctrl+D to finish):"
    readme=$(cat)

    local visibility_companies_json
    visibility_companies_json=$(json_array_from_csv "$visibility_companies_csv")

    create_skill_entity "$name" "$description" "$readme" "$license" "$compatibility" "$owner_company" "$visibility_companies_json" draft
    
    success "Created skill '$name' (draft)"
    info "Activate with: pv activate skill $name"
}

cmd_edit_template() {
    ensure_vault
    check_deps jq
    local name="${1:-}"
    [ -z "$name" ] && { error "Usage: pv edit-template <name>"; exit 1; }

    local tmp_file current_record current_content current_description content version_before version_after
    current_record=$(require_entity_record_json template "$name" "content, description, version" "status IN ('active', 'draft')")
    current_content=$(printf '%s' "$current_record" | jq -r '.rows[0].content')
    current_description=$(printf '%s' "$current_record" | jq -r '.rows[0].description // ""')
    version_before=$(printf '%s' "$current_record" | jq -r '.rows[0].version')

    make_temp_file tmp_file .md
    printf '%s\n' "$current_content" > "$tmp_file"

    ${EDITOR:-nano} "$tmp_file"

    content=$(cat "$tmp_file")
    if [ "$content" = "$current_content" ]; then
        info "No changes made to '$name'"
        return 0
    fi

    version_after=$(update_entity_content_and_description template "$name" "$content" "$current_description" "Updated template '$name'")

    success "Updated template '$name'"
    info "Version: ${version_before:-0} -> ${version_after:-0}"
    refresh_pi_projection_after_template_change "$name" "template update"
}

cmd_activate() {
    ensure_vault
    local type="${1:-}"
    local name="${2:-}"
    
    [ -z "$type" ] || [ -z "$name" ] && { error "Usage: pv activate <template|skill> <name>"; exit 1; }

    set_entity_status "$type" "$name" active
    success "Activated $type '$name'"
    if [ "$type" = "template" ]; then
        refresh_pi_projection_after_template_change "$name" "template activation"
    fi
}

cmd_publish() {
    ensure_vault
    local name="${1:-}"
    [ -z "$name" ] && { error "Usage: pv publish <template>"; exit 1; }

    set_template_export_flag "$name" true
    success "Published template '$name' for pi export"
    refresh_pi_projection_after_template_change "$name" "template publish"
}

cmd_unpublish() {
    ensure_vault
    local name="${1:-}"
    [ -z "$name" ] && { error "Usage: pv unpublish <template>"; exit 1; }

    local escaped_name status_before export_before force_refresh
    escaped_name=$(sql_escape "$name")
    status_before=$(json_first_field "SELECT status FROM prompt_templates WHERE name = '$escaped_name' LIMIT 1" status)
    export_before=$(json_first_field "SELECT export_to_pi FROM prompt_templates WHERE name = '$escaped_name' LIMIT 1" export_to_pi)
    case "$export_before" in
        1|true|TRUE) export_before="true" ;;
        0|false|FALSE|"") export_before="false" ;;
    esac
    force_refresh="false"
    if [ "$status_before" = "active" ] && [ "$export_before" = "true" ]; then
        force_refresh="true"
    fi

    set_template_export_flag "$name" false
    success "Unpublished template '$name' from pi export"
    refresh_pi_projection_after_template_change "$name" "template unpublish" "$force_refresh"
}

cmd_deprecate() {
    ensure_vault
    local type="${1:-}"
    local name="${2:-}"
    
    [ -z "$type" ] || [ -z "$name" ] && { error "Usage: pv deprecate <template|skill> <name>"; exit 1; }

    local escaped_name status_before export_before force_refresh
    force_refresh="false"
    if [ "$type" = "template" ]; then
        escaped_name=$(sql_escape "$name")
        status_before=$(json_first_field "SELECT status FROM prompt_templates WHERE name = '$escaped_name' LIMIT 1" status)
        export_before=$(json_first_field "SELECT export_to_pi FROM prompt_templates WHERE name = '$escaped_name' LIMIT 1" export_to_pi)
        case "$export_before" in
            1|true|TRUE) export_before="true" ;;
            0|false|FALSE|"") export_before="false" ;;
        esac
        if [ "$status_before" = "active" ] && [ "$export_before" = "true" ]; then
            force_refresh="true"
        fi
    fi

    set_entity_status "$type" "$name" deprecated
    success "Deprecated $type '$name'"
    if [ "$type" = "template" ]; then
        refresh_pi_projection_after_template_change "$name" "template deprecation" "$force_refresh"
    fi
}

cmd_branch() {
    ensure_vault
    local branch_name="${1:-}"
    [ -z "$branch_name" ] && { error "Usage: pv branch <name>"; exit 1; }
    
    dolt checkout -b "$branch_name"
    success "Created branch: $branch_name"
}

cmd_merge() {
    ensure_vault
    local branch_name="${1:-}"
    [ -z "$branch_name" ] && { error "Usage: pv merge <branch>"; exit 1; }
    
    dolt merge "$branch_name"
    success "Merged branch: $branch_name"
}

cmd_log() {
    ensure_vault
    local type="${1:-}"
    local name="${2:-}"
    
    if [ -n "$type" ] && [ -n "$name" ]; then
        if [ "$type" = "template" ]; then
            dolt log -n 10 -- "*prompt_templates*"
        else
            dolt log -n 10 -- "*skills*"
        fi
    else
        dolt log -n 10
    fi
}

cmd_diff() {
    ensure_vault
    local from="${1:-HEAD~1}"
    local to="${2:-HEAD}"
    
    dolt diff "$from" "$to"
}

cmd_stats() {
    ensure_vault
    local name="${1:-}"
    
    if [ -n "$name" ]; then
        local escaped_name
        local exists
        escaped_name=$(sql_escape "$name")
        exists=$(json_first_field "SELECT COUNT(*) AS count FROM prompt_templates WHERE name = '$escaped_name' AND status = 'active'" count)
        if [ "$exists" = "0" ]; then
            error "Active template '$name' not found"
            exit 1
        fi

        echo "=== Statistics: $name ==="
        dolt sql -q "
            SELECT
                t.name,
                t.version,
                t.status,
                COALESCE(exec.executions, 0) AS executions,
                COALESCE(exec.successes, 0) AS successes,
                exec.avg_latency_ms,
                COALESCE(exec.captured_outputs, 0) AS captured_outputs,
                COALESCE(feed.feedback_rows, 0) AS feedback_rows,
                feed.avg_rating,
                exec.last_execution_at
            FROM prompt_templates t
            LEFT JOIN (
                SELECT
                    entity_id,
                    COUNT(*) AS executions,
                    SUM(CASE WHEN success THEN 1 ELSE 0 END) AS successes,
                    ROUND(AVG(latency_ms), 1) AS avg_latency_ms,
                    SUM(CASE WHEN output_text IS NOT NULL THEN 1 ELSE 0 END) AS captured_outputs,
                    MAX(created_at) AS last_execution_at
                FROM executions
                WHERE entity_type = 'template'
                GROUP BY entity_id
            ) exec ON exec.entity_id = t.id
            LEFT JOIN (
                SELECT
                    e.entity_id,
                    COUNT(f.id) AS feedback_rows,
                    ROUND(AVG(f.rating), 2) AS avg_rating
                FROM executions e
                LEFT JOIN feedback f ON f.execution_id = e.id
                WHERE e.entity_type = 'template'
                GROUP BY e.entity_id
            ) feed ON feed.entity_id = t.id
            WHERE t.name = '$escaped_name' AND t.status = 'active'
            ORDER BY t.version DESC
            LIMIT 1
        " -r tabular
    else
        echo "=== Overall Statistics ==="
        dolt sql -q "
            SELECT 
                'Templates' as type,
                COUNT(*) as total,
                SUM(CASE WHEN status = 'active' THEN 1 ELSE 0 END) as active,
                SUM(CASE WHEN status = 'draft' THEN 1 ELSE 0 END) as draft
            FROM prompt_templates
            UNION ALL
            SELECT 
                'Skills',
                COUNT(*),
                SUM(CASE WHEN status = 'active' THEN 1 ELSE 0 END),
                SUM(CASE WHEN status = 'draft' THEN 1 ELSE 0 END)
            FROM skills
        " -r tabular
    fi
}

cmd_retrievals() {
    ensure_vault
    local mode="${1:-summary}"

    case "$mode" in
        summary)
            echo "=== Retrieval Analytics (SQLite sidecar) ==="
            analytics_query "
                SELECT * FROM v_retrievals_by_entity
                ORDER BY retrieval_count DESC
                LIMIT 25;
            "
            echo ""
            local total
            total=$(sqlite3 "$(analytics_db_path)" "SELECT COUNT(*) FROM retrieval_events;" 2>/dev/null || echo 0)
            echo "Total events: $total (append-only; no retention job)"
            ;;
        daily)
            echo "=== Daily Retrievals ==="
            analytics_query "
                SELECT * FROM v_retrievals_daily
                ORDER BY day DESC
                LIMIT 30;
            "
            ;;
        *)
            usage_error "pv retrievals [summary|daily]" "Unknown mode: $mode"
            ;;
    esac
}

cmd_show() {
    ensure_vault
    local type="${1:-}"
    local name="${2:-}"
    local version="${3:-}"
    
    [ -z "$type" ] || [ -z "$name" ] && { error "Usage: pv show <template|skill> <name> [version]"; exit 1; }
    
    local escaped_name
    escaped_name=$(sql_escape "$name")

    if [ -n "$version" ]; then
        require_numeric "$version" version
    fi

    if [ "$type" = "template" ]; then
        if [ -n "$version" ]; then
            dolt sql -q "SELECT * FROM prompt_templates WHERE name = '$escaped_name' AND version = $version" -r tabular
        else
            dolt sql -q "SELECT name, description, owner_company, visibility_companies, artifact_kind, control_mode, formalization_level, controlled_vocabulary, status, export_to_pi, version, created_at, updated_at FROM prompt_templates WHERE name = '$escaped_name' AND status IN ('active', 'draft') ORDER BY version DESC LIMIT 1" -r tabular
            echo ""
            echo "Content:"
            json_first_field "SELECT content FROM prompt_templates WHERE name = '$escaped_name' AND status IN ('active', 'draft') ORDER BY version DESC LIMIT 1" content
        fi
    elif [ "$type" = "skill" ]; then
        dolt sql -q "SELECT * FROM skills WHERE name = '$escaped_name' AND status = 'active' ORDER BY version DESC LIMIT 1" -r tabular
    else
        error "Type must be 'template' or 'skill'"
        exit 1
    fi
}

cmd_history() {
    ensure_vault
    local type="${1:-template}"
    local name="${2:-}"
    
    if [ -z "$name" ]; then
        error "Usage: pv history <template|skill> <name>"
        exit 1
    fi

    local current entity_id current_version current_status updated_at changelog_count

    echo "=== History: $type '$name' ==="
    echo ""

    current=$(require_entity_record_json "$type" "$name" "id, version, status, updated_at")
    entity_id=$(printf '%s' "$current" | jq -r '.rows[0].id')
    current_version=$(printf '%s' "$current" | jq -r '.rows[0].version')
    current_status=$(printf '%s' "$current" | jq -r '.rows[0].status')
    updated_at=$(printf '%s' "$current" | jq -r '.rows[0].updated_at')
    changelog_count=$(json_first_field "SELECT COUNT(*) AS count FROM changelog WHERE entity_type = '$type' AND entity_id = $entity_id" count)

    echo "Current state:"
    printf '  version: %s\n' "$current_version"
    printf '  status: %s\n' "$current_status"
    printf '  updated_at: %s\n' "$updated_at"
    echo ""
    echo "Changelog:"

    if [ "$changelog_count" = "0" ]; then
        echo "  No entity-scoped changelog entries recorded yet."
    else
        dolt sql -q "
            SELECT change_type, old_version, new_version, summary, author, created_at
            FROM changelog
            WHERE entity_type = '$type' AND entity_id = $entity_id
            ORDER BY created_at DESC
        " -r tabular
    fi
}

cmd_rollback() {
    ensure_vault
    local type="${1:-}"
    local name="${2:-}"
    local commit_ref="${3:-}"

    [ -z "$type" ] || [ -z "$name" ] || [ -z "$commit_ref" ] && {
        error "Usage: pv rollback <template|skill> <name> <commit-ref>"
        error "  commit-ref: HEAD~1, HEAD~3, or commit hash"
        exit 1
    }

    local table content_column escaped_name escaped_ref content_record content desc
    table=$(entity_table_for_type "$type")
    content_column=$(entity_content_column_for_type "$type")
    escaped_name=$(sql_escape "$name")
    escaped_ref=$(sql_escape "$commit_ref")

    content_record=$(json_first_field_record "SELECT $content_column FROM $table AS OF '$escaped_ref' WHERE name = '$escaped_name' LIMIT 1" "$content_column")
    if [ "$(printf '%s' "$content_record" | jq -r '.found')" != "true" ]; then
        error "$type '$name' not found at $commit_ref"
        exit 1
    fi
    content=$(printf '%s' "$content_record" | jq -r '.value')
    desc=$(json_first_field "SELECT description FROM $table AS OF '$escaped_ref' WHERE name = '$escaped_name' LIMIT 1" description)
    update_entity_content_and_description "$type" "$name" "$content" "$desc" "Rolled back $type '$name' to $commit_ref" >/dev/null

    success "Rolled back $type '$name' to state at $commit_ref"
    if [ "$type" = "template" ]; then
        refresh_pi_projection_after_template_change "$name" "template rollback"
    fi
    info "Commit with: pv commit 'Rollback $name to $commit_ref'"
}

cmd_commit() {
    ensure_vault
    local message="${1:-Update}"
    
    dolt add .
    dolt commit -m "$message"
    success "Committed: $message"
}

cmd_status() {
    ensure_vault
    dolt status
}

cmd_sql() {
    ensure_vault
    dolt sql "$@"
}

cmd_push() {
    ensure_vault
    local remote="${1:-origin}"
    local branch="${2:-}"

    if [ -z "$branch" ]; then
        branch=$(dolt branch --show-current 2>/dev/null | tr -d '[:space:]')
    fi

    if [ -z "$branch" ]; then
        usage_error "pv push [remote] [branch]" "Could not determine current branch"
    fi

    dolt push "$remote" "$branch"
    success "Pushed $branch to $remote"
}

cmd_pull() {
    ensure_vault
    local remote="${1:-origin}"
    dolt pull "$remote"
    success "Pulled from $remote"
}

cmd_clone() {
    local remote="${1:-}"
    [ -z "$remote" ] && { error "Usage: pv clone <remote-url>"; exit 1; }
    
    cd "$(dirname "$VAULT_DIR")"
    dolt clone "$remote" prompt-vault-db
    success "Cloned vault from $remote"
}

cmd_watch() {
    ensure_vault
    local debounce_sec="${1:-2}"
    local last_hash=""
    local pending=0
    
    info "Watching for changes... (Ctrl+C to stop)"
    info "Auto-exporting to pi format (debounce: ${debounce_sec}s)"
    
    # Track content hash for smarter detection
    get_content_hash() {
        dolt sql -r csv -q "
            SELECT MD5(CONCAT(
                (SELECT GROUP_CONCAT(content ORDER BY name) FROM prompt_templates WHERE status = 'active'),
                (SELECT GROUP_CONCAT(readme ORDER BY name) FROM skills WHERE status = 'active')
            ))
        " 2>/dev/null | tail -1
    }
    
    last_hash=$(get_content_hash)
    
    while true; do
        sleep 1
        
        # Check for dolt working tree changes
        if ! dolt diff --quiet 2>/dev/null; then
            pending=1
        fi
        
        # Debounce: wait for stability
        if [ "$pending" -eq 1 ]; then
            sleep "$debounce_sec"
            
            # Check if still stable after debounce period
            if dolt diff --quiet 2>/dev/null; then
                pending=0
            fi
            
            # Check if content actually changed
            local current_hash
            current_hash=$(get_content_hash)
            if [ "$current_hash" != "$last_hash" ]; then
                info "Content changed, exporting..."
                cmd_export > /dev/null
                last_hash="$current_hash"
                success "Exported ($(date +%H:%M:%S))"
            else
                # Only schema/structure changed, no export needed
                info "Non-content change detected, skipping export"
            fi
            
            pending=0
        fi
    done
}

