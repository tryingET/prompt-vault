cmd_cleanup() {
    ensure_vault
    local cleanup_usage="pv cleanup [days] [--dry-run]"
    local days="30"
    local dry_run="false"
    local days_set=0

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --dry-run)
                if [ "$dry_run" = "true" ]; then
                    usage_error "$cleanup_usage" "Duplicate option: --dry-run"
                fi
                dry_run="true"
                shift
                ;;
            --*)
                usage_error "$cleanup_usage" "Unknown option: $1"
                ;;
            *)
                if [ "$days_set" -eq 1 ]; then
                    usage_error "$cleanup_usage" "Unexpected argument: $1"
                fi
                days="$1"
                days_set=1
                shift
                ;;
        esac
    done

    require_numeric "$days" days
    echo "=== Execution Log Cleanup ==="
    echo "(retrieval analytics live in the SQLite sidecar; append-only, no cleanup needed)"
    
    # Count records to delete
    local count
    count=$(dolt sql -r csv -q "
        SELECT COUNT(*) FROM executions 
        WHERE created_at < DATE_SUB(NOW(), INTERVAL $days DAY)
    " | tail -1)

    # Count total records
    local total
    total=$(dolt sql -r csv -q "SELECT COUNT(*) FROM executions" | tail -1)

    echo "Total executions: $total"
    echo "Older than $days days: $count"
    
    if [ "$dry_run" = "true" ]; then
        echo ""
        echo "(dry-run mode - no changes made)"
        echo "To actually delete: pv cleanup $days"
        return 0
    fi
    
    local did_work=0

    if [ "$count" -gt 0 ]; then
        echo ""
        info "Deleting $count old execution records..."

        # Delete old executions (cascades to feedback)
        dolt sql -q "
            DELETE FROM executions 
            WHERE created_at < DATE_SUB(NOW(), INTERVAL $days DAY)
        "

        # Also clean orphaned feedback
        dolt sql -q "
            DELETE FROM feedback 
            WHERE execution_id NOT IN (SELECT id FROM executions)
        " 2>/dev/null || true
        did_work=1
    fi

    if [ "$did_work" -eq 0 ]; then
        success "No records to clean up"
        return 0
    fi

    # Commit
    dolt add -A
    dolt commit -m "Cleanup: removed $count executions + rolled up $ret_count retrievals older than $days days" 2>/dev/null || true

    success "Cleaned up $count old records"
    
    # Show new totals
    local new_total
    new_total=$(dolt sql -r csv -q "SELECT COUNT(*) FROM executions" | tail -1)
    echo "Remaining executions: $new_total"
}

cmd_vocabulary() {
    ensure_vault
    echo "=== Governed Vocabulary ==="
    echo ""

    if [ -f "$SCRIPT_DIR/../ontology/controlled-vocabulary-contract.json" ]; then
        echo "## controlled vocabulary"
        jq -r '.dimensions | to_entries[] | "### " + .key + ":\n" + (.value | map("  - " + .) | join("\n")) + "\n"' "$SCRIPT_DIR/../ontology/controlled-vocabulary-contract.json"
        echo "## semantic metamodel"
        jq -r '.dimension_semantics | to_entries[] | "### " + .key + "\n  - category: " + .value.ontological_category + "\n  - cardinality: " + .value.cardinality + "\n  - question: " + .value.question + "\n"' "$SCRIPT_DIR/../ontology/controlled-vocabulary-contract.json"
    fi

    if [ -f "$SCRIPT_DIR/../ontology/company-visibility-contract.json" ]; then
        echo "## company visibility"
        jq -r '"### companies:\n" + (.companies | map("  - " + .) | join("\n")) + "\n"' "$SCRIPT_DIR/../ontology/company-visibility-contract.json"
    fi

    echo "## Summary"
    echo "  Controlled-vocabulary templates: $(dolt sql -q "SELECT COUNT(*) FROM prompt_templates WHERE status = 'active' AND controlled_vocabulary IS NOT NULL" -r csv 2>/dev/null | tail -1)"
    echo "  Core-owned templates: $(dolt sql -q "SELECT COUNT(*) FROM prompt_templates WHERE status = 'active' AND owner_company = 'core'" -r csv 2>/dev/null | tail -1)"
    echo "  Total templates: $(dolt sql -q "SELECT COUNT(*) FROM prompt_templates WHERE status = 'active'" -r csv 2>/dev/null | tail -1)"
}

usage() {
    cat << 'EOF'
Prompt Vault CLI - Version-controlled prompt templates and skills

Usage: pv <command> [args]

Setup:
  init                     Initialize a new vault
  clone <url>              Clone from DoltHub
  migrate up               Run database migrations
  seed-v2                  Deprecated; router prompt bodies now live only in the canonical DB
  hooks install            Install git hooks

Import/Export:
  import                   Import from pi templates/skills
  export                   Export to pi format
  export-fmt <format>      Export to various formats (md,json,ts,py)
  watch                    Watch and auto-export changes

Templates:
  templates [facet|k=v]    List templates, optionally filtered by ontology facet, owner/visibility field, or cv.<key>=<value>
  new-template <name>      Create new template
  edit-template <name>     Edit template
  show template <name>     Show template content
  history template <name>  Show version history
  vars [name]              List template variables

Skills:
  skills                   List all skills
  new-skill <name>         Create new skill
  show skill <name>        Show skill details
  history skill <name>     Show version history

Collections:
  collection list          List all collections
  collection create <n>    Create new collection
  collection show <n>      Show collection contents
  collection add-template  Add template to collection

Search & Analytics:
  search <query>           Search templates and skills
  stats [name]             Usage statistics
  analytics [cmd]          Detailed analytics (including safe output-capture summaries)
  quality [cmd]            Quality scores and dashboard
  vocabulary               Show governed controlled vocabulary
  exec <template> [args]   Execute template with tracking (use --output-file/--output-text to capture output)
  rate <id> <rating>       Rate an execution

Quality & Tools:
  lint [name]              Lint templates/skills
  backup <cmd>             Backup/restore operations
  scaffold <type> <name>   Generate scaffolds

Integration:
  integrate <cmd>          Export to external formats
  tui                      Interactive terminal UI
  quick                    Quick actions menu

Version Control:
  branch <name>            Create experimental branch
  merge <branch>           Merge branch to current
  log [type] [name]        View commit history
  diff [from] [to]         Compare versions
  rollback <template|skill> <name> <commit-ref>
                           Restore an entity from a Dolt commit ref

Status:
  status                   Working directory status
  commit [message]         Commit changes
  activate <t|s> <name>    Set status to active
  publish <template>       Mark template for pi export
  unpublish <template>     Remove template from pi export
  deprecate <t|s> <name>   Set status to deprecated

Releases:
  tag list                 List all release tags
  tag release <version>    Create release tag
  tag status               Show current tag status
  tag changelog            Generate changelog

Remote:
  push [remote] [branch]   Push current branch by default, or an explicit branch
  pull [remote]            Pull from DoltHub

Maintenance:
  cleanup [days]           Remove old execution logs (default: 30 days)
  cleanup N --dry-run      Preview what would be deleted

Advanced:
  sql <query>              Run SQL directly

Examples:
  pv init                          # Initialize vault
  pv import                        # Import existing templates
  pv templates router              # Filter templates by a facet value
  pv templates owner_company=core
  pv templates cv.routing_context=review_followup
  pv search review                 # Search for "review"
  pv rollback template review HEAD~1 # Restore review from previous commit
  pv vars                          # Show all template variables
  pv quality dashboard             # View quality scores + evidence gaps
  pv quality coverage              # Show feedback/capture coverage by entity
  pv quality rollup control_mode         # Aggregate quality/evidence by governed facet
  pv quality rollup routing_context      # Aggregate quality/evidence by exact-one router vocabulary
  pv quality rollup selection_principles # Aggregate quality/evidence by multi-valued router semantics
  pv quality rollup visibility_companies # Aggregate quality/evidence by multi-valued company visibility
  pv analytics outputs             # Safe output-capture analytics (public previews only)
  pv exec review src/foo.ts --output-file /tmp/llm-output.txt --public-output
  pv scaffold template my-review   # Generate template scaffold
  pv lint                          # Lint all templates
  pv backup create                 # Create backup
  pv integrate langchain           # Export for LangChain
  pv tui                           # Interactive browser
  pv quick                         # Quick actions menu
  pv export-fmt typescript         # Export to TypeScript
EOF
}

# Main
case "${1:-}" in
    init) cmd_init "${@:2}" ;;
    import) cmd_import "${@:2}" ;;
    export) cmd_export "${@:2}" ;;
    export-fmt) shift; cmd_export_formats "$@" ;;
    templates) cmd_templates "${@:2}" ;;
    skills) cmd_skills "${@:2}" ;;
    new-template) cmd_new_template "${@:2}" ;;
    new-skill) cmd_new_skill "${@:2}" ;;
    edit-template) cmd_edit_template "${@:2}" ;;
    show) cmd_show "${@:2}" ;;
    history) cmd_history "${@:2}" ;;
    branch) cmd_branch "${@:2}" ;;
    merge) cmd_merge "${@:2}" ;;
    log) cmd_log "${@:2}" ;;
    diff) shift; cmd_enhanced_diff "$@" ;;
    rollback) cmd_rollback "${@:2}" ;;
    status) cmd_status "${@:2}" ;;
    commit) cmd_commit "${@:2}" ;;
    activate) cmd_activate "${@:2}" ;;
    publish) cmd_publish "${@:2}" ;;
    unpublish) cmd_unpublish "${@:2}" ;;
    deprecate) cmd_deprecate "${@:2}" ;;
    stats) cmd_stats "${@:2}" ;;
    push) cmd_push "${@:2}" ;;
    pull) cmd_pull "${@:2}" ;;
    clone) cmd_clone "${@:2}" ;;
    watch) cmd_watch "${@:2}" ;;
    sql) shift; cmd_sql "$@" ;;
    search) shift; cmd_search "$@" ;;
    exec) shift; cmd_exec "$@" ;;
    rate) shift; cmd_rate "$@" ;;
    retrievals) cmd_retrievals "${@:2}" ;;
    analytics) shift; cmd_analytics "$@" ;;
    collection) shift; cmd_collection "$@" ;;
    migrate) shift; cmd_migrate "$@" ;;
    seed-v2) shift; cmd_seed_v2 "$@" ;;
    lint) shift; cmd_lint "$@" ;;
    backup) shift; cmd_backup "$@" ;;
    integrate) shift; cmd_integrate "$@" ;;
    tui) shift; cmd_tui "$@" ;;
    quality) shift; cmd_quality "$@" ;;
    scaffold) shift; cmd_scaffold "$@" ;;
    hooks) shift; cmd_hooks "$@" ;;
    quick) shift; cmd_quick "$@" ;;
    vars) shift; cmd_vars "$@" ;;
    tag) shift; cmd_tag "$@" ;;
    vocabulary) cmd_vocabulary ;;
    cleanup) shift; cmd_cleanup "$@" ;;
    -h|--help|help) usage ;;
    -v|--version) echo "pv version $VERSION" ;;
    *) usage; exit 1 ;;
esac
