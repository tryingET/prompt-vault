}

cmd_clone() {
    local remote="${1:-}"
    [ -z "$remote" ] && { error "Usage: pv clone <remote-url>"; exit 1; }
    
    cd "$(dirname "$VAULT_DIR")"
    dolt clone "$remote" prompt-vault-db
    success "Cloned vault from $remote"
}

cmd_watch() {
    ensure_vault
    local debounce_sec="${1:-2}"
    local last_hash=""
    local pending=0
    
    info "Watching for changes... (Ctrl+C to stop)"
    info "Auto-exporting to pi format (debounce: ${debounce_sec}s)"
    
    # Track content hash for smarter detection
    get_content_hash() {
        dolt sql -r csv -q "
            SELECT MD5(CONCAT(
                (SELECT GROUP_CONCAT(content ORDER BY name) FROM prompt_templates WHERE status = 'active'),
                (SELECT GROUP_CONCAT(readme ORDER BY name) FROM skills WHERE status = 'active')
            ))
        " 2>/dev/null | tail -1
    }
    
    last_hash=$(get_content_hash)
    
    while true; do
        sleep 1
        
        # Check for dolt working tree changes
        if ! dolt diff --quiet 2>/dev/null; then
            pending=1
        fi
        
        # Debounce: wait for stability
        if [ "$pending" -eq 1 ]; then
            sleep "$debounce_sec"
            
            # Check if still stable after debounce period
            if dolt diff --quiet 2>/dev/null; then
                pending=0
            fi
            
            # Check if content actually changed
            local current_hash=$(get_content_hash)
            if [ "$current_hash" != "$last_hash" ]; then
                info "Content changed, exporting..."
                cmd_export > /dev/null
                last_hash="$current_hash"
                success "Exported ($(date +%H:%M:%S))"
            else
                # Only schema/structure changed, no export needed
                info "Non-content change detected, skipping export"
            fi
            
            pending=0
        fi
    done
}

