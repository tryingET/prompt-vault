#!/usr/bin/env bash
# pv - Prompt Vault CLI
# Unified interface for managing versioned prompt templates and skills
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VERSION="1.0.0"

# Source shared library
source "$SCRIPT_DIR/pv-lib.sh"

cmd_init() {
    export VAULT_DIR
    "$SCRIPT_DIR/init-vault.sh" "$@"
}

cmd_import() {
    ensure_vault
    export VAULT_DIR
    "$SCRIPT_DIR/import-from-pi.sh" "$@"
}

cmd_export() {
    ensure_vault
    export VAULT_DIR
    "$SCRIPT_DIR/export-to-pi.sh" "$@"
}

cmd_templates() {
    ensure_vault
    local facet_filter="${1:-}"
    local where=""

    if [ -n "$facet_filter" ]; then
        if [[ "$facet_filter" == *=* ]]; then
            local facet_name="${facet_filter%%=*}"
            local facet_value="${facet_filter#*=}"
            if [ "$facet_name" = "export_to_pi" ]; then
                case "$facet_value" in
                    true|TRUE|1) where="WHERE export_to_pi = TRUE" ;;
                    false|FALSE|0) where="WHERE export_to_pi = FALSE" ;;
                    *) error "export_to_pi filter must be true/false"; exit 1 ;;
                esac
            elif [ "$facet_name" = "visibility_company" ]; then
                where="WHERE JSON_SEARCH(visibility_companies, 'one', '${facet_value}') IS NOT NULL"
            elif [[ "$facet_name" == cv.* ]]; then
                local cv_key="${facet_name#cv.}"
                if [ "$cv_key" = "selection_principles" ]; then
                    where="WHERE JSON_SEARCH(controlled_vocabulary, 'one', '${facet_value}', NULL, '$.selection_principles[*]') IS NOT NULL"
                else
                    where="WHERE JSON_UNQUOTE(JSON_EXTRACT(controlled_vocabulary, '$.${cv_key}')) = '${facet_value}'"
                fi
            else
                where="WHERE ${facet_name} = '${facet_value}'"
            fi
        else
            where="WHERE artifact_kind = '$facet_filter' OR control_mode = '$facet_filter' OR formalization_level = '$facet_filter'"
        fi
        echo "=== Prompt Templates ($facet_filter) ==="
    else
        echo "=== Prompt Templates ==="
    fi

    dolt sql -q "
        SELECT name, owner_company, artifact_kind, control_mode, formalization_level,
               JSON_UNQUOTE(JSON_EXTRACT(controlled_vocabulary, '$.routing_context')) AS routing_context,
               JSON_UNQUOTE(JSON_EXTRACT(controlled_vocabulary, '$.activity_phase')) AS activity_phase,
               JSON_UNQUOTE(JSON_EXTRACT(controlled_vocabulary, '$.transition_target_type')) AS transition_target_type,
               status, export_to_pi, version
        FROM prompt_templates
        $where
        ORDER BY artifact_kind, control_mode, formalization_level, name
    " -r tabular
}

cmd_skills() {
    ensure_vault
    echo "=== Skills ==="
    dolt sql -q "
        SELECT name, owner_company, description, status, version 
        FROM skills 
        ORDER BY name
    " -r tabular
}

cmd_new_template() {
    ensure_vault
    local name="${1:-}"
    [ -z "$name" ] && { error "Usage: pv new-template <name>"; exit 1; }

    info "Creating template: $name"

    echo -n "Description: "
    read -r description

    echo -n "Artifact kind [procedure]: "
    read -r artifact_kind
    artifact_kind=${artifact_kind:-procedure}

    echo -n "Control mode [one_shot]: "
    read -r control_mode
    control_mode=${control_mode:-one_shot}

    echo -n "Formalization level [structured]: "
    read -r formalization_level
    formalization_level=${formalization_level:-structured}

    echo -n "Owner company [core]: "
    read -r owner_company
    owner_company=${owner_company:-core}

    echo -n "Visibility companies (comma-separated) [core,software,finance,house,health,teaching,holding]: "
    read -r visibility_companies_csv
    visibility_companies_csv=${visibility_companies_csv:-core,software,finance,house,health,teaching,holding}

    local visibility_companies_json visibility_companies_sql
    visibility_companies_json=$(python3 - <<PY
import json
items = [item.strip() for item in """$visibility_companies_csv""".split(",") if item.strip()]
print(json.dumps(items))
PY
)
    visibility_companies_sql="'$(echo "$visibility_companies_json" | sed "s/'/''/g")'"

    local controlled_vocabulary_sql="NULL"
    if [ "$control_mode" = "router" ]; then
        local routing_context activity_phase input_artifact transition_target_type selection_principles_csv output_commitment controlled_vocabulary_json escaped_controlled_vocabulary

        echo -n "Routing context [analysis_followup]: "
        read -r routing_context
        routing_context=${routing_context:-analysis_followup}

        echo -n "Activity phase [post_analysis]: "
        read -r activity_phase
        activity_phase=${activity_phase:-post_analysis}

        echo -n "Input artifact [analysis_output]: "
        read -r input_artifact
        input_artifact=${input_artifact:-analysis_output}

        echo -n "Transition target type [framework_mode]: "
        read -r transition_target_type
        transition_target_type=${transition_target_type:-framework_mode}

        echo -n "Selection principles (comma-separated) [evidence_based]: "
        read -r selection_principles_csv
        selection_principles_csv=${selection_principles_csv:-evidence_based}

        echo -n "Output commitment [exact_next_prompt]: "
        read -r output_commitment
        output_commitment=${output_commitment:-exact_next_prompt}

        controlled_vocabulary_json=$(python3 - <<PY
import json
items = [item.strip() for item in """$selection_principles_csv""".split(",") if item.strip()]
print(json.dumps({
  "routing_context": """$routing_context""".strip(),
  "activity_phase": """$activity_phase""".strip(),
  "input_artifact": """$input_artifact""".strip(),
  "transition_target_type": """$transition_target_type""".strip(),
  "selection_principles": items,
  "output_commitment": """$output_commitment""".strip(),
}))
PY
)
        escaped_controlled_vocabulary=$(echo "$controlled_vocabulary_json" | sed "s/'/''/g")
        controlled_vocabulary_sql="'$escaped_controlled_vocabulary'"
    fi

    echo "Content (Ctrl+D to finish):"
    content=$(cat)

    local escaped_name=$(echo "$name" | sed "s/'/''/g")
    local escaped_content=$(echo "$content" | sed "s/'/''/g")
    local escaped_desc=$(echo "$description" | sed "s/'/''/g")

    dolt sql -q "
        INSERT INTO prompt_templates (name, description, content, artifact_kind, control_mode, formalization_level, owner_company, visibility_companies, controlled_vocabulary, status)
        VALUES ('$escaped_name', '$escaped_desc', '$escaped_content', '$artifact_kind', '$control_mode', '$formalization_level', '$owner_company', $visibility_companies_sql, $controlled_vocabulary_sql, 'draft')
    "

    success "Created template '$name' (draft)"
    info "Edit with: pv edit-template $name"
    info "Activate with: pv activate template $name"
}

cmd_new_skill() {
    ensure_vault
    local name="${1:-}"
    [ -z "$name" ] && { error "Usage: pv new-skill <name>"; exit 1; }
    
    info "Creating skill: $name"
    
    echo -n "Description: "
    read -r description
    
    echo -n "License [MIT]: "
    read -r license
    license=${license:-MIT}
    
    echo -n "Compatibility: "
    read -r compatibility

    echo -n "Owner company [core]: "
    read -r owner_company
    owner_company=${owner_company:-core}

    echo -n "Visibility companies (comma-separated) [core,software,finance,house,health,teaching,holding]: "
    read -r visibility_companies_csv
    visibility_companies_csv=${visibility_companies_csv:-core,software,finance,house,health,teaching,holding}
    
    echo "README content (Ctrl+D to finish):"
    readme=$(cat)
    
    local escaped_readme=$(echo "$readme" | sed "s/'/''/g")
    local escaped_desc=$(echo "$description" | sed "s/'/''/g")
    local visibility_companies_json visibility_companies_sql
    visibility_companies_json=$(python3 - <<PY
import json
items = [item.strip() for item in """$visibility_companies_csv""".split(",") if item.strip()]
print(json.dumps(items))
PY
)
    visibility_companies_sql="'$(echo "$visibility_companies_json" | sed "s/'/''/g")'"
    
    dolt sql -q "
        INSERT INTO skills (name, description, readme, license, compatibility, owner_company, visibility_companies, status)
        VALUES ('$name', '$escaped_desc', '$escaped_readme', '$license', '$compatibility', '$owner_company', $visibility_companies_sql, 'draft')
    "
    
    success "Created skill '$name' (draft)"
    info "Activate with: pv activate skill $name"
}

cmd_edit_template() {
    ensure_vault
    local name="${1:-}"
    [ -z "$name" ] && { error "Usage: pv edit-template <name>"; exit 1; }
    
    # Export to temp file
    local tmp_file=$(mktemp --suffix=.md)
    local escaped_name=$(sql_escape "$name")
    json_first_field "SELECT content FROM prompt_templates WHERE name = '$escaped_name' AND status = 'active' ORDER BY version DESC LIMIT 1" content > "$tmp_file"
    
    # Open editor
    ${EDITOR:-nano} "$tmp_file"
    
    # Read back and update
    local content
    content=$(cat "$tmp_file")
    local escaped_content
    escaped_content=$(sql_escape "$content")
    
    dolt sql -q "CALL create_template_version('$escaped_name', (SELECT description FROM prompt_templates WHERE name = '$escaped_name' LIMIT 1), '$escaped_content', NULL)"
    
    rm "$tmp_file"
    success "Updated template '$name'"
}

cmd_activate() {
    ensure_vault
    local type="${1:-}"
    local name="${2:-}"
    
    [ -z "$type" ] || [ -z "$name" ] && { error "Usage: pv activate <template|skill> <name>"; exit 1; }
    
    if [ "$type" = "template" ]; then
        dolt sql -q "UPDATE prompt_templates SET status = 'active' WHERE name = '$name'"
    elif [ "$type" = "skill" ]; then
        dolt sql -q "UPDATE skills SET status = 'active' WHERE name = '$name'"
    else
        error "Type must be 'template' or 'skill'"
        exit 1
    fi
    
    success "Activated $type '$name'"
}

cmd_publish() {
    ensure_vault
    local name="${1:-}"
    [ -z "$name" ] && { error "Usage: pv publish <template>"; exit 1; }

    local escaped_name
    escaped_name=$(sql_escape "$name")
    dolt sql -q "UPDATE prompt_templates SET export_to_pi = TRUE WHERE name = '$escaped_name'"
    success "Published template '$name' for pi export"
}

cmd_unpublish() {
    ensure_vault
    local name="${1:-}"
    [ -z "$name" ] && { error "Usage: pv unpublish <template>"; exit 1; }

    local escaped_name
    escaped_name=$(sql_escape "$name")
    dolt sql -q "UPDATE prompt_templates SET export_to_pi = FALSE WHERE name = '$escaped_name'"
    success "Unpublished template '$name' from pi export"
}

cmd_deprecate() {
    ensure_vault
    local type="${1:-}"
    local name="${2:-}"
    
    [ -z "$type" ] || [ -z "$name" ] && { error "Usage: pv deprecate <template|skill> <name>"; exit 1; }
    
    if [ "$type" = "template" ]; then
        dolt sql -q "UPDATE prompt_templates SET status = 'deprecated' WHERE name = '$name'"
    elif [ "$type" = "skill" ]; then
        dolt sql -q "UPDATE skills SET status = 'deprecated' WHERE name = '$name'"
    fi
    
    success "Deprecated $type '$name'"
}

cmd_branch() {
    ensure_vault
    local branch_name="${1:-}"
    [ -z "$branch_name" ] && { error "Usage: pv branch <name>"; exit 1; }
    
    dolt checkout -b "$branch_name"
    success "Created branch: $branch_name"
}

cmd_merge() {
    ensure_vault
    local branch_name="${1:-}"
    [ -z "$branch_name" ] && { error "Usage: pv merge <branch>"; exit 1; }
    
    dolt merge "$branch_name"
    success "Merged branch: $branch_name"
}

cmd_log() {
    ensure_vault
    local type="${1:-}"
    local name="${2:-}"
    
    if [ -n "$type" ] && [ -n "$name" ]; then
        if [ "$type" = "template" ]; then
            dolt log -n 10 -- "*prompt_templates*"
        else
            dolt log -n 10 -- "*skills*"
        fi
    else
        dolt log -n 10
    fi
}

cmd_diff() {
    ensure_vault
    local from="${1:-HEAD~1}"
    local to="${2:-HEAD}"
    
    dolt diff "$from" "$to"
}

cmd_stats() {
    ensure_vault
    local name="${1:-}"
    
    if [ -n "$name" ]; then
        dolt sql -q "CALL template_stats('$name')" -r tabular
    else
        echo "=== Overall Statistics ==="
        dolt sql -q "
            SELECT 
                'Templates' as type,
                COUNT(*) as total,
                SUM(CASE WHEN status = 'active' THEN 1 ELSE 0 END) as active,
                SUM(CASE WHEN status = 'draft' THEN 1 ELSE 0 END) as draft
            FROM prompt_templates
            UNION ALL
            SELECT 
                'Skills',
                COUNT(*),
                SUM(CASE WHEN status = 'active' THEN 1 ELSE 0 END),
                SUM(CASE WHEN status = 'draft' THEN 1 ELSE 0 END)
            FROM skills
        " -r tabular
    fi
}

cmd_show() {
    ensure_vault
    local type="${1:-}"
    local name="${2:-}"
    local version="${3:-}"
    
    [ -z "$type" ] || [ -z "$name" ] && { error "Usage: pv show <template|skill> <name> [version]"; exit 1; }
    
    local escaped_name
    escaped_name=$(sql_escape "$name")

    if [ "$type" = "template" ]; then
        if [ -n "$version" ]; then
            dolt sql -q "SELECT * FROM prompt_templates WHERE name = '$escaped_name' AND version = $version" -r tabular
        else
            dolt sql -q "SELECT name, description, owner_company, visibility_companies, artifact_kind, control_mode, formalization_level, controlled_vocabulary, status, export_to_pi, version, created_at, updated_at FROM prompt_templates WHERE name = '$escaped_name' AND status IN ('active', 'draft') ORDER BY version DESC LIMIT 1" -r tabular
            echo ""
            echo "Content:"
            json_first_field "SELECT content FROM prompt_templates WHERE name = '$escaped_name' AND status IN ('active', 'draft') ORDER BY version DESC LIMIT 1" content
        fi
    elif [ "$type" = "skill" ]; then
        dolt sql -q "SELECT * FROM skills WHERE name = '$name' AND status = 'active' ORDER BY version DESC LIMIT 1" -r tabular
    fi
}

cmd_history() {
    ensure_vault
    local type="${1:-template}"
    local name="${2:-}"
    
    if [ -z "$name" ]; then
        error "Usage: pv history <template|skill> <name>"
        exit 1
    fi
    
    local table="prompt_templates"
    [ "$type" = "skill" ] && table="skills"
    
    echo "=== History: $type '$name' ==="
    echo ""
    
    # Get current state
    local current=$(dolt sql -r json -q "
        SELECT id, version, status, updated_at 
        FROM $table 
        WHERE name = '$name' 
        LIMIT 1
    " 2>/dev/null)
    
    if [ -z "$current" ] || [ "$(echo "$current" | jq -r '.rows | length')" -eq 0 ]; then
        error "$type '$name' not found"
        exit 1
    fi
    
    local entity_id=$(echo "$current" | jq -r '.rows[0].id')
    local current_version=$(echo "$current" | jq -r '.rows[0].version')
    
    # Get changelog entries
    echo "Changelog:"
    dolt sql -q "
        SELECT change_type, old_version, new_version, summary, author, created_at 
        FROM changelog 
        WHERE entity_type = '$type' AND entity_id = $entity_id
        ORDER BY created_at DESC
    " -r tabular 2>/dev/null || echo "  No changelog entries"
    
    echo ""
    echo "Dolt commits affecting this $type:"
    
    # Find commits that touched this table
    dolt log --oneline -- "$table" 2>/dev/null | head -10
    
    echo ""
    echo "Current: version $current_version"
}

cmd_rollback() {
    ensure_vault
    local type="${1:-}"
    local name="${2:-}"
    local commit_ref="${3:-}"
    
    [ -z "$type" ] || [ -z "$name" ] || [ -z "$commit_ref" ] && { 
        error "Usage: pv rollback <template|skill> <name> <commit-ref>"
        error "  commit-ref: HEAD~1, HEAD~3, or commit hash"
        exit 1
    }
    
    local table="prompt_templates"
    [ "$type" = "skill" ] && table="skills"
    
    # Get content from the specified commit
    local content=$(dolt sql -r csv -q "SELECT content FROM $table AS OF '$commit_ref' WHERE name = '$name'" 2>/dev/null | tail -1)
    
    if [ -z "$content" ]; then
        error "$type '$name' not found at $commit_ref"
        exit 1
    fi
    
    local desc=$(dolt sql -r csv -q "SELECT description FROM $table AS OF '$commit_ref' WHERE name = '$name'" 2>/dev/null | tail -1)
    
    # Escape for SQL
    local escaped=$(echo "$content" | sed "s/'/''/g")
    local escaped_desc=""
    [ -n "$desc" ] && escaped_desc=$(echo "$desc" | sed "s/'/''/g")
    
    # Update current version
    if [ "$type" = "template" ]; then
        dolt sql -q "UPDATE prompt_templates SET content = '$escaped', description = '$escaped_desc' WHERE name = '$name'"
    else
        dolt sql -q "UPDATE skills SET readme = '$escaped', description = '$escaped_desc' WHERE name = '$name'"
    fi
    
    success "Rolled back $type '$name' to state at $commit_ref"
    info "Commit with: pv commit 'Rollback $name to $commit_ref'"
}

cmd_commit() {
    ensure_vault
    local message="${1:-Update}"
    
    dolt add .
    dolt commit -m "$message"
    success "Committed: $message"
}

