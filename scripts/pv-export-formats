#!/usr/bin/env bash
# pv-export-formats - Export to various formats
# Usage: pv-export-formats <format> [output]
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VAULT_DIR="${VAULT_DIR:-$SCRIPT_DIR/../prompt-vault-db}"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/pv-lib.sh"

format="${1:-help}"
output="${2:-}"

template_rows_sql="SELECT name, description, content FROM prompt_templates WHERE status = 'active' ORDER BY name"
skill_rows_sql="SELECT name, description, readme FROM skills WHERE status = 'active' ORDER BY name"

case "$format" in
    markdown)
        ensure_vault
        check_deps jq

        output="${output:-./prompt-vault-export}"
        mkdir -p "$output/templates" "$output/skills"

        echo "Exporting to Markdown..."

        while IFS= read -r row_b64; do
            [ -z "$row_b64" ] && continue
            row_json=$(json_decode_base64 "$row_b64")
            name=$(printf '%s' "$row_json" | jq -r '.name')
            desc=$(printf '%s' "$row_json" | jq -r '.description // ""')
            content=$(printf '%s' "$row_json" | jq -r '.content // ""')

            cat > "$output/templates/${name}.md" << EOF
# $name

> $desc

## Prompt

$content
EOF
        done < <(json_rows_base64 "$template_rows_sql")

        while IFS= read -r row_b64; do
            [ -z "$row_b64" ] && continue
            row_json=$(json_decode_base64 "$row_b64")
            name=$(printf '%s' "$row_json" | jq -r '.name')
            readme=$(printf '%s' "$row_json" | jq -r '.readme // ""')
            printf '%s\n' "$readme" > "$output/skills/${name}.md"
        done < <(json_rows_base64 "$skill_rows_sql")

        {
            echo "# Prompt Vault Export"
            echo ""
            echo "Generated: $(date)"
            echo ""
            echo "## Templates"
            echo ""
            while IFS= read -r row_b64; do
                [ -z "$row_b64" ] && continue
                row_json=$(json_decode_base64 "$row_b64")
                name=$(printf '%s' "$row_json" | jq -r '.name')
                desc=$(printf '%s' "$row_json" | jq -r '.description // ""')
                echo "- [$name](templates/${name}.md) - $desc"
            done < <(json_rows_base64 "$template_rows_sql")
            echo ""
            echo "## Skills"
            echo ""
            while IFS= read -r row_b64; do
                [ -z "$row_b64" ] && continue
                row_json=$(json_decode_base64 "$row_b64")
                name=$(printf '%s' "$row_json" | jq -r '.name')
                desc=$(printf '%s' "$row_json" | jq -r '.description // ""')
                echo "- [$name](skills/${name}.md) - $desc"
            done < <(json_rows_base64 "$skill_rows_sql")
        } > "$output/README.md"

        echo "✓ Exported to $output/"
        ;;

    jsonl)
        ensure_vault
        check_deps jq

        output="${output:-./prompts.jsonl}"

        echo "Exporting to JSONL..."

        {
            dolt_json_query "$template_rows_sql" | jq -c '.rows[] | {type: "template", name, description, content}'
            dolt_json_query "$skill_rows_sql" | jq -c '.rows[] | {type: "skill", name, description, readme}'
        } > "$output"

        echo "✓ Exported to $output ($(wc -l < "$output") records)"
        ;;

    yaml)
        ensure_vault
        check_deps jq

        output="${output:-./prompts.yaml}"

        echo "Exporting to YAML..."

        {
            echo "templates:"
            while IFS= read -r row_b64; do
                [ -z "$row_b64" ] && continue
                row_json=$(json_decode_base64 "$row_b64")
                name=$(printf '%s' "$row_json" | jq -r '.name')
                desc_json=$(printf '%s' "$row_json" | jq -r '.description // "" | @json')
                content=$(printf '%s' "$row_json" | jq -r '.content // ""')
                echo "  - name: $name"
                echo "    description: $desc_json"
                echo "    content: |"
                printf '%s\n' "$content" | sed 's/^/      /'
            done < <(json_rows_base64 "$template_rows_sql")

            echo ""
            echo "skills:"
            while IFS= read -r row_b64; do
                [ -z "$row_b64" ] && continue
                row_json=$(json_decode_base64 "$row_b64")
                name=$(printf '%s' "$row_json" | jq -r '.name')
                desc_json=$(printf '%s' "$row_json" | jq -r '.description // "" | @json')
                echo "  - name: $name"
                echo "    description: $desc_json"
            done < <(json_rows_base64 "$skill_rows_sql")
        } > "$output"

        echo "✓ Exported to $output"
        ;;

    typescript)
        ensure_vault
        check_deps jq

        output="${output:-./prompts.ts}"

        echo "Exporting to TypeScript..."

        {
            echo "// Auto-generated from Prompt Vault"
            echo "// Generated: $(date)"
            echo ""
            echo "export interface PromptTemplate {"
            echo "  name: string;"
            echo "  description: string;"
            echo "  content: string;"
            echo "  variables: string[];"
            echo "}"
            echo ""
            echo "export interface Skill {"
            echo "  name: string;"
            echo "  description: string;"
            echo "  readme: string;"
            echo "}"
            echo ""
            echo "export const templates: PromptTemplate[] = "
            dolt_json_query "$template_rows_sql" | jq '[.rows[] | {name, description, content, variables: []}]'
            echo ";"
            echo ""
            echo "export const skills: Skill[] = "
            dolt_json_query "$skill_rows_sql" | jq '[.rows[] | {name, description, readme}]'
            echo ";"
        } > "$output"

        echo "✓ Exported to $output"
        ;;

    python)
        ensure_vault
        check_deps jq

        output="${output:-./prompts.py}"

        echo "Exporting to Python..."

        templates_json_b64=$(dolt_json_query "$template_rows_sql" | jq -r '(.rows // []) | @base64')
        skills_json_b64=$(dolt_json_query "$skill_rows_sql" | jq -r '(.rows // []) | @base64')
        templates_json_b64_literal=$(printf '%s' "$templates_json_b64" | jq -Rs .)
        skills_json_b64_literal=$(printf '%s' "$skills_json_b64" | jq -Rs .)

        {
            echo '"""Auto-generated from Prompt Vault"""'
            echo "# Generated: $(date)"
            echo "import base64"
            echo "import json"
            echo ""
            printf 'TEMPLATES_JSON_B64 = %s\n' "$templates_json_b64_literal"
            printf 'SKILLS_JSON_B64 = %s\n' "$skills_json_b64_literal"
            echo ""
            echo "TEMPLATES_JSON = base64.b64decode(TEMPLATES_JSON_B64).decode('utf-8')"
            echo "SKILLS_JSON = base64.b64decode(SKILLS_JSON_B64).decode('utf-8')"
            echo ""
            echo "# Usage: templates = json.loads(TEMPLATES_JSON)"
        } > "$output"

        echo "✓ Exported to $output"
        ;;

    csv)
        ensure_vault

        output="${output:-./prompts.csv}"

        echo "Exporting to CSV..."

        echo "type,name,description,content" > "$output"
        dolt sql -r csv -q "SELECT 'template', name, description, content FROM prompt_templates WHERE status = 'active'" | tail -n +2 >> "$output"
        dolt sql -r csv -q "SELECT 'skill', name, description, readme FROM skills WHERE status = 'active'" | tail -n +2 >> "$output"

        echo "✓ Exported to $output"
        ;;

    help|*)
        cat << 'EOF'
Usage: pv-export-formats <format> [output]

Export vault to various formats.

Formats:
  markdown [dir]    Export as Markdown files with index
  jsonl [file]      Export as JSON Lines (one object per line)
  yaml [file]       Export as YAML
  typescript [file] Export as TypeScript with types
  python [file]     Export as Python dataclasses
  csv [file]        Export as CSV

Examples:
  pv-export-formats markdown ./docs
  pv-export-formats jsonl ./data/prompts.jsonl
  pv-export-formats typescript ./src/prompts.ts
  pv-export-formats python ./prompts.py
EOF
        ;;
esac
