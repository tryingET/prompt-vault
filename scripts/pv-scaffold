#!/usr/bin/env bash
# pv-scaffold - Generate template/skill scaffolds
# Usage: pv-scaffold <type> <name> [options]
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VAULT_DIR="${VAULT_DIR:-$SCRIPT_DIR/../prompt-vault-db}"

# shellcheck disable=SC1091
source "$SCRIPT_DIR/pv-lib.sh"

type="${1:-help}"
name="${2:-}"
extra_arg_1="${3:-}"

scaffold_template() {
    local name="$1"
    local category="${2:-general}"
    
    cat << EOF
---
description: TODO: Add description (50-150 chars recommended)
---

# $name

TODO: Add prompt instructions here.

## Inputs

- \$1 - First argument description
- \$@ - All arguments

## Output

Describe expected output format.

## Example

\`\`\`
/$name example-arg
\`\`\`

## Prompt

You are a specialized assistant for $category tasks.

Context: \$@

Instructions:
1. Analyze the input
2. Apply best practices for $category
3. Provide structured output

Output format:
- Section 1: Analysis
- Section 2: Recommendations
- Section 3: Action items
EOF
}

scaffold_skill() {
    local name="$1"
    local category="${2:-general}"
    
    cat << EOF
---
name: $name
description: TODO: Add description (50-150 chars, required by Agent Skills spec)
license: MIT
compatibility: pi >= 1.0
---

# $name

TODO: Add skill description here.

## When to Use

Use this skill when:
- Condition 1
- Condition 2
- Condition 3

## Setup

\`\`\`bash
# One-time setup commands
cd /path/to/skill
npm install  # or other dependencies
\`\`\`

## Usage

### Basic Usage

\`\`\`bash
./scripts/main.sh <args>
\`\`\`

### Advanced Usage

\`\`\`bash
./scripts/main.sh --option value
\`\`\`

## Examples

### Example 1: Basic

\`\`\`bash
./scripts/main.sh "input"
\`\`\`

### Example 2: With Options

\`\`\`bash
./scripts/main.sh --verbose --format json "input"
\`\`\`

## Configuration

| Option | Default | Description |
|--------|---------|-------------|
| \`--option\` | \`default\` | Description |

## Files

\`\`\`
$name/
├── SKILL.md          # This file
├── scripts/
│   └── main.sh       # Main script
└── references/
    └── advanced.md   # Advanced documentation
\`\`\`

## Troubleshooting

### Common Issues

**Issue: Something doesn't work**
Solution: Check configuration

## See Also

- Related skill 1
- Related skill 2
EOF
}

scaffold_collection() {
    local name="$1"
    local description="$2"
    
    cat << EOF
Collection: $name
Description: $description

To add items to this collection:
  pv collection add-template $name <template-name>
  pv collection add-skill $name <skill-name>

To export:
  pv collection export $name

To show contents:
  pv collection show $name
EOF
}

scaffold_script() {
    local name="$1"
    local type="${2:-helper}"
    
    cat << 'EOF'
#!/usr/bin/env bash
# Script: <name>
# Purpose: <description>
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Configuration
CONFIG_FILE="${CONFIG_FILE:-$SCRIPT_DIR/config.sh}"

# Functions
log() { echo "[$(date +%H:%M:%S)] $*"; }
error() { echo "[$(date +%H:%M:%S)] ERROR: $*" >&2; exit 1; }

# Main
main() {
    local arg="${1:-}"
    
    [ -z "$arg" ] && error "Usage: $0 <arg>"
    
    log "Processing: $arg"
    # Add logic here
}

main "$@"
EOF
}

scaffold_reference() {
    local name="$1"
    local topic="${2:-api}"
    
    cat << EOF
# $name Reference

## Overview

This reference document covers $topic for $name.

## Quick Reference

| Command | Description |
|---------|-------------|
| \`command1\` | Description |
| \`command2\` | Description |

## Detailed Reference

### Section 1

Content here.

### Section 2

Content here.

## Examples

\`\`\`bash
# Example command
command --option value
\`\`\`

## See Also

- Related documentation
EOF
}

frontmatter_field() {
    local field="$1"
    local path="$2"

    python3 - "$field" "$path" <<'PY'
import pathlib
import sys

field = sys.argv[1]
path = pathlib.Path(sys.argv[2])
text = path.read_text()
if not text.startswith('---\n'):
    raise SystemExit(0)
parts = text.split('\n---\n', 1)
if len(parts) != 2:
    raise SystemExit(0)
frontmatter = parts[0].splitlines()[1:]
for line in frontmatter:
    if line.startswith(field + ':'):
        print(line.split(':', 1)[1].strip())
        break
PY
}

body_without_frontmatter() {
    local path="$1"

    python3 - "$path" <<'PY'
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
text = path.read_text()
if text.startswith('---\n'):
    parts = text.split('\n---\n', 1)
    if len(parts) == 2:
        print(parts[1], end='')
        raise SystemExit(0)
print(text, end='')
PY
}

case "$type" in
    template)
        [ -z "$name" ] && { echo "Usage: pv-scaffold template <name> [category]" >&2; exit 1; }
        scaffold_template "$name" "${extra_arg_1:-general}"
        ;;
    
    skill)
        [ -z "$name" ] && { echo "Usage: pv-scaffold skill <name> [category]" >&2; exit 1; }
        scaffold_skill "$name" "${extra_arg_1:-general}"
        ;;
    
    collection)
        [ -z "$name" ] && { echo "Usage: pv-scaffold collection <name> <description>" >&2; exit 1; }
        scaffold_collection "$name" "${extra_arg_1:-Collection of prompts}"
        ;;
    
    script)
        [ -z "$name" ] && { echo "Usage: pv-scaffold script <name> [type]" >&2; exit 1; }
        scaffold_script "$name" "${extra_arg_1:-helper}"
        ;;
    
    reference)
        [ -z "$name" ] && { echo "Usage: pv-scaffold reference <name> [topic]" >&2; exit 1; }
        scaffold_reference "$name" "${extra_arg_1:-api}"
        ;;
    
    create)
        create_type="${2:-}"
        create_name="${3:-}"
        [ -z "$create_type" ] || [ -z "$create_name" ] && {
            echo "Usage: pv-scaffold create <template|skill|script|reference> <name>" >&2
            exit 1
        }
        
        case "$create_type" in
            template)
                ensure_vault
                scaffold_file=""
                make_temp_file scaffold_file .md
                scaffold_template "$create_name" > "$scaffold_file"
                ${EDITOR:-nano} "$scaffold_file"

                desc=$(frontmatter_field description "$scaffold_file")
                content=$(body_without_frontmatter "$scaffold_file")
                visibility_companies_json=$(json_array_from_csv "core,software,finance,house,health,teaching,holding")
                create_template_entity "$create_name" "$desc" "$content" procedure one_shot structured core "$visibility_companies_json" "" draft

                echo "✓ Created template '$create_name' (draft)"
                echo "Activate with: pv activate template $create_name"
                ;;
            
            skill)
                skill_dir=$(mktemp -d "${TMPDIR:-/tmp}/pv-skill-scaffold.XXXXXX")
                mkdir -p "$skill_dir/scripts" "$skill_dir/references"
                scaffold_skill "$create_name" > "$skill_dir/SKILL.md"
                ${EDITOR:-nano} "$skill_dir/SKILL.md"
                echo "✓ Created skill scaffold at $skill_dir/"
                echo "Move to: ~/.pi/agent/skills/$create_name/"
                ;;
            
            *)
                echo "Only template and skill creation supported" >&2
                exit 1
                ;;
        esac
        ;;
    
    help|--help|-h|*)
        cat << 'EOF'
Usage: pv-scaffold <type> <name> [options]

Generate scaffolds for prompts and skills.

Types:
  template <name> [category]   Generate template scaffold
  skill <name> [category]      Generate skill scaffold (SKILL.md)
  collection <name> <desc>     Generate collection description
  script <name> [type]         Generate bash script scaffold
  reference <name> [topic]     Generate reference doc scaffold

Create (writes to vault):
  create template <name>       Create and edit new template
  create skill <name>          Create skill directory structure

Examples:
  pv-scaffold template code-review
  pv-scaffold skill pdf-processor
  pv-scaffold create template my-review
  pv-scaffold script process.sh
EOF
        if [ "$type" != "help" ] && [ "$type" != "--help" ] && [ "$type" != "-h" ] && [ -n "$type" ]; then
            exit 1
        fi
        ;;
esac
