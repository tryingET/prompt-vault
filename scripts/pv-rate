#!/usr/bin/env bash
# pv-rate - Record feedback for an execution
# Usage: pv-rate <execution-id> <rating> [notes] [--issues issue1,issue2]
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VAULT_DIR="${VAULT_DIR:-$SCRIPT_DIR/../prompt-vault-db}"

# shellcheck disable=SC1091
source "$SCRIPT_DIR/pv-lib.sh"
check_deps jq

EXEC_ID="${1:-}"
RATING="${2:-}"
shift 2 || true

NOTES=""
ISSUES="[]"
WOULD_USE_AGAIN="TRUE"

while [[ $# -gt 0 ]]; do
    case $1 in
        --issues|-i)
            ISSUES=$(echo "$2" | jq -R 'split(",")')
            shift 2
            ;;
        --would-use-again|--no-use-again)
            WOULD_USE_AGAIN=$([[ "$1" == "--would-use-again" ]] && echo "TRUE" || echo "FALSE")
            shift
            ;;
        *)
            NOTES="$NOTES $1"
            shift
            ;;
    esac
done

if [ -z "$EXEC_ID" ] || [ -z "$RATING" ]; then
    echo "Usage: pv-rate <execution-id> <rating> [notes] [--issues i1,i2] [--would-use-again|--no-use-again]" >&2
    exit 1
fi

require_numeric "$EXEC_ID" execution-id

# Validate rating
if ! [[ "$RATING" =~ ^[1-5]$ ]]; then
    echo "Error: Rating must be 1-5" >&2
    exit 1
fi

NOTES=$(printf '%s' "$NOTES" | sed 's/^ *//;s/ *$//')
RAW_NOTES="$NOTES"
NOTES=$(sql_escape "$NOTES")
ISSUES=$(sql_escape "$ISSUES")

cd "$VAULT_DIR"

# Check execution exists
EXISTS=$(dolt sql -r csv -q "SELECT COUNT(*) FROM executions WHERE id = $EXEC_ID" | tail -1)
if [ "$EXISTS" = "0" ]; then
    echo "Error: Execution $EXEC_ID not found" >&2
    exit 1
fi

# Refuse duplicate feedback for the same execution before attempting insert.
EXISTING_FEEDBACK=$(dolt sql -r csv -q "SELECT COUNT(*) FROM feedback WHERE execution_id = $EXEC_ID" | tail -1)
if [ "$EXISTING_FEEDBACK" != "0" ]; then
    echo "Error: Feedback already exists for execution $EXEC_ID" >&2
    exit 1
fi

# Insert feedback. Schema-level uniqueness is the final concurrency guard.
set +e
INSERT_OUTPUT=$(dolt sql -q "
    INSERT INTO feedback (execution_id, rating, notes, issues, would_use_again)
    VALUES ($EXEC_ID, $RATING, '$NOTES', '$ISSUES', $WOULD_USE_AGAIN)
" 2>&1)
INSERT_STATUS=$?
set -e

if [ "$INSERT_STATUS" -ne 0 ]; then
    if [[ "$INSERT_OUTPUT" == *"unique_feedback_execution"* ]] || [[ "$INSERT_OUTPUT" == *"Duplicate entry"* ]]; then
        echo "Error: Feedback already exists for execution $EXEC_ID" >&2
    else
        echo "$INSERT_OUTPUT" >&2
    fi
    exit 1
fi

echo "✓ Recorded feedback for execution $EXEC_ID"
echo "  Rating: $RATING/5"
[ -n "$RAW_NOTES" ] && echo "  Notes: $RAW_NOTES"
echo ""

entity_record=$(dolt sql -r json -q "
    SELECT e.entity_type,
           pt.name AS template_name,
           s.name AS skill_name
    FROM executions e
    LEFT JOIN prompt_templates pt ON e.entity_type = 'template' AND e.entity_id = pt.id
    LEFT JOIN skills s ON e.entity_type = 'skill' AND e.entity_id = s.id
    WHERE e.id = $EXEC_ID
    LIMIT 1
")
entity_type=$(printf '%s' "$entity_record" | jq -r '.rows[0].entity_type // empty')
entity_name=$(printf '%s' "$entity_record" | jq -r '.rows[0].template_name // .rows[0].skill_name // empty')

case "$entity_type" in
    template)
        echo "View stats: pv stats $entity_name"
        ;;
    skill)
        echo "View skill: pv show skill $entity_name"
        ;;
    *)
        echo "View execution: pv sql \"SELECT * FROM executions WHERE id = $EXEC_ID\""
        ;;
esac
