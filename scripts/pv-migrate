#!/usr/bin/env bash
# pv-migrate - Run database migrations
# Usage: pv-migrate [up|down|status|create]
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VAULT_DIR="${VAULT_DIR:-$SCRIPT_DIR/../prompt-vault-db}"
MIGRATIONS_DIR="$SCRIPT_DIR/../migrations"

cd "$VAULT_DIR"

cmd="${1:-status}"

case "$cmd" in
    status)
        echo "=== Migration Status ==="
        
        # Check if schema_version table exists
        EXISTS=$(dolt sql -r csv -q "SHOW TABLES LIKE 'schema_version'" 2>/dev/null | tail -1)
        
        if [ "$EXISTS" != "schema_version" ]; then
            echo "Schema version table not found (v0 or uninitialized)"
            echo ""
            echo "Run 'pv migrate up' to initialize"
            exit 0
        fi
        
        echo "Current schema version:"
        dolt sql -q "SELECT version, description, applied_at FROM schema_version ORDER BY id DESC LIMIT 1" -r tabular
        echo ""
        echo "Migration history:"
        dolt sql -q "SELECT id, version, description, applied_at FROM schema_version ORDER BY id" -r tabular
        
        # Check for pending migrations
        CURRENT_VERSION=$(dolt sql -r csv -q "SELECT MAX(version) FROM schema_version" 2>/dev/null | tail -1)
        CURRENT_VERSION=${CURRENT_VERSION:-0}
        
        echo ""
        echo "Available migration files:"
        if [ -d "$MIGRATIONS_DIR" ]; then
            ls -1 "$MIGRATIONS_DIR"/*.sql 2>/dev/null | while read f; do
                basename "$f"
            done || echo "  (none)"
        else
            echo "  (migrations directory not found)"
        fi
        ;;

    up)
        # Create schema_version table if needed
        dolt sql -q "
            CREATE TABLE IF NOT EXISTS schema_version (
                id INT AUTO_INCREMENT PRIMARY KEY,
                version INT NOT NULL,
                description VARCHAR(255),
                applied_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                INDEX idx_version (version)
            )
        " 2>/dev/null || true
        
        # Get current version
        CURRENT_VERSION=$(dolt sql -r csv -q "SELECT MAX(version) FROM schema_version" 2>/dev/null | tail -1)
        CURRENT_VERSION=${CURRENT_VERSION:-0}
        if [ "$CURRENT_VERSION" = "NULL" ] || [ -z "$CURRENT_VERSION" ]; then
            CURRENT_VERSION=0
        fi
        
        # If no version, insert initial baseline
        if [ "$CURRENT_VERSION" = "NULL" ] || [ -z "$CURRENT_VERSION" ]; then
            dolt sql -q "INSERT INTO schema_version (version, description) VALUES (1, 'Initial baseline')"
            CURRENT_VERSION=1
            echo "Initialized schema at version 1"
        fi
        
        echo "=== Running migrations (current: v$CURRENT_VERSION) ==="
        
        # Run any pending migrations from files
        PENDING=0
        for migration in $(ls -1 "$MIGRATIONS_DIR"/*.sql 2>/dev/null | sort); do
            filename=$(basename "$migration")
            
            # Extract version from filename (e.g., 002-add-foo.sql -> 2)
            MIG_VERSION=$(echo "$filename" | grep -o '^[0-9]*' | sed 's/^0*//')
            MIG_VERSION=${MIG_VERSION:-0}
            
            if [ "$MIG_VERSION" -le "$CURRENT_VERSION" ]; then
                echo "  ✓ $filename (already applied)"
                continue
            fi
            
            echo "  Running: $filename"
            PENDING=$((PENDING + 1))
            
            # Run migration
            if dolt sql < "$migration" 2>&1; then
                # Record migration
                dolt sql -q "
                    INSERT INTO schema_version (version, description)
                    VALUES ($MIG_VERSION, 'Migration: $filename')
                "
                echo "  ✓ Applied $filename"
            else
                echo "  ✗ Failed: $filename"
                exit 1
            fi
        done
        
        if [ "$PENDING" -eq 0 ]; then
            echo "No pending migrations"
        else
            dolt add .
            dolt commit -m "Applied $PENDING migration(s)" 2>/dev/null || true
            echo ""
            echo "Migrations complete"
        fi
        ;;

    create)
        name="${2:-}"
        [ -z "$name" ] && { echo "Usage: pv-migrate create <name>" >&2; exit 1; }
        
        mkdir -p "$MIGRATIONS_DIR"
        
        # Get next number
        NEXT=$(ls -1 "$MIGRATIONS_DIR"/*.sql 2>/dev/null | wc -l)
        NEXT=$((NEXT + 2))  # Start at 002 since 001 is baseline
        NUM=$(printf "%03d" $NEXT)
        
        filename="${NUM}-${name}.sql"
        filepath="$MIGRATIONS_DIR/$filename"
        
        cat > "$filepath" << 'EOF'
-- Migration: <description>
-- Run: pv migrate up (or dolt sql < migrations/<filename>)

-- Add your SQL here


-- Record migration (version should match filename prefix)
-- INSERT INTO schema_version (version, description) VALUES (N, 'Description');
SELECT 'Migration complete' AS status;
EOF
        
        echo "Created: $filepath"
        ${EDITOR:-nano} "$filepath"
        ;;

    rollback)
        # Rollback last migration
        LAST=$(dolt sql -r csv -q "
            SELECT version, description FROM schema_version ORDER BY id DESC LIMIT 1
        " 2>/dev/null)
        
        if [ -z "$LAST" ] || [ "$LAST" = "version,description" ]; then
            echo "No migrations to rollback"
            exit 0
        fi
        
        VERSION=$(echo "$LAST" | tail -1 | cut -d',' -f1)
        DESC=$(echo "$LAST" | tail -1 | cut -d',' -f2-)
        
        echo "Last migration: v${VERSION} - ${DESC}"
        echo ""
        echo "Rollback requires manual SQL to reverse the changes."
        echo "After reversing, run:"
        echo "  dolt sql -q \"DELETE FROM schema_version WHERE version = $VERSION\""
        echo "  dolt commit -m \"Rollback: v$VERSION\""
        echo ""
        echo "Or use dolt reset to undo the entire commit:"
        echo "  dolt reset --hard HEAD~1"
        ;;

    *)
        cat >&2 << 'EOF'
Usage: pv-migrate <command>

Commands:
  status    Show migration status
  up        Run all pending migrations
  create    Create new migration file
  rollback  Show rollback instructions (manual)

Migration files are stored in: migrations/
Naming: NNN-description.sql (e.g., 002-add-indexes.sql)
EOF
        exit 1
        ;;
esac
