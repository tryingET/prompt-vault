#!/usr/bin/env bash
# pv-exec - Prepare a prompt; optionally record caller-supplied output with unknown outcome
# Usage: pv-exec <template-name> [args...] [--model <model>] [--output-file <path>|--output-text <text>] [--public-output]
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VAULT_DIR="${VAULT_DIR:-$SCRIPT_DIR/../prompt-vault-db}"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/pv-lib.sh"

# Parse args
TEMPLATE="${1:-}"
shift || true

MODEL=""
OUTPUT_TEXT=""
OUTPUT_CAPTURE_MODE="none"
OUTPUT_SUPPLIED=false
PUBLIC_OUTPUT=false
ARGS=()
while [[ $# -gt 0 ]]; do
    case $1 in
        --model|-m)
            [ $# -ge 2 ] || { echo "Error: --model requires a label" >&2; exit 1; }
            MODEL="$2"
            shift 2
            ;;
        --output-file)
            [ $# -ge 2 ] || { echo "Error: --output-file requires a path" >&2; exit 1; }
            [ -f "$2" ] || { echo "Error: output file not found: $2" >&2; exit 1; }
            OUTPUT_TEXT=$(<"$2")
            OUTPUT_SUPPLIED=true
            shift 2
            ;;
        --output-text)
            [ $# -ge 2 ] || { echo "Error: --output-text requires a value" >&2; exit 1; }
            OUTPUT_TEXT="$2"
            OUTPUT_SUPPLIED=true
            shift 2
            ;;
        --public-output)
            PUBLIC_OUTPUT=true
            shift
            ;;
        --*)
            echo "Unknown option: $1" >&2
            exit 1
            ;;
        *)
            ARGS+=("$1")
            shift
            ;;
    esac
done

if [ -z "$TEMPLATE" ]; then
    echo "Usage: pv-exec <template-name> [args...] [--model <model>] [--output-file <path>|--output-text <text>] [--public-output]" >&2
    exit 1
fi

if [ "$OUTPUT_SUPPLIED" = true ]; then
    OUTPUT_CAPTURE_MODE="private"
fi

if [ "$PUBLIC_OUTPUT" = true ]; then
    if [ "$OUTPUT_SUPPLIED" != true ]; then
        echo "Error: --public-output requires --output-file or --output-text" >&2
        exit 1
    fi
    OUTPUT_CAPTURE_MODE="public"
fi

ARGS_JSON=$(python3 -c 'import json,sys; print(json.dumps(sys.argv[1:]))' "${ARGS[@]}")
if [ "$OUTPUT_SUPPLIED" = true ]; then
    OUTPUT_TEXT_SQL="'$(sql_escape "$OUTPUT_TEXT")'"
else
    OUTPUT_TEXT_SQL="NULL"
fi

VAULT_DIR=$(cd "$VAULT_DIR" && pwd)
cd "$VAULT_DIR"
check_deps jq python3

# Get template ID, content, and version safely via JSON
ESCAPED_TEMPLATE=$(sql_escape "$TEMPLATE")
RESULT=$(dolt_json_query "
    SELECT id, content, version 
    FROM prompt_templates 
    WHERE name = '$ESCAPED_TEMPLATE' AND status = 'active' 
    ORDER BY version DESC LIMIT 1
")

if [ "$(echo "$RESULT" | jq -r '.rows | length')" = "0" ]; then
    echo "Error: Template '$TEMPLATE' not found or not active" >&2
    exit 1
fi

TEMPLATE_ID=$(echo "$RESULT" | jq -r '.rows[0].id')
TEMPLATE_VERSION=$(echo "$RESULT" | jq -r '.rows[0].version')
CONTENT=$(echo "$RESULT" | jq -r '.rows[0].content // ""')

# Substitute variables using the shared template semantics
CONTENT=$(expand_template_content "$CONTENT" "${ARGS[@]}")

# Preparing text does not invoke a model, dispatch a workflow, or assess an outcome.
echo "=== Prepared template: $TEMPLATE (v$TEMPLATE_VERSION) ==="
echo "Model: ${MODEL:-not invoked} (no model call performed)"
echo "Args: ${ARGS[*]}"
echo ""
echo "--- Prompt ---"
echo "$CONTENT"
echo "--- End Prompt ---"
echo ""

# Default preparation is read-only. An explicit supplied-output option records
# caller-provided observation, not model execution or successful requested work.
if [ "$OUTPUT_SUPPLIED" != true ]; then
    echo "Preparation only: no execution record created; outcome not assessed."
    exit 0
fi

python3 - "$VAULT_DIR" "$SCRIPT_DIR" <<'PY'
import sys
from pathlib import Path
sys.path.insert(0, sys.argv[2])
from pv_scoped_db import preflight
preflight(Path(sys.argv[1]).resolve())
PY
MODEL_SQL="NULL"
if [ -n "$MODEL" ]; then MODEL_SQL="'$(sql_escape "$MODEL")'"; fi
ESCAPED_ARGS=$(sql_escape "$ARGS_JSON")
OBSERVATION='{"schema":"prompt-vault/execution-observation/v1","event":"caller_supplied_output","accepted_outcome":"not_assessed","model_execution":"not_verified"}'

EXEC_ID=$(dolt sql -r csv -q "
    INSERT INTO executions (entity_type, entity_id, entity_version, input_args, input_context, model, output_capture_mode, output_text, latency_ms, success, input_tokens, output_tokens)
    VALUES ('template', $TEMPLATE_ID, $TEMPLATE_VERSION, '$ESCAPED_ARGS', '$OBSERVATION', $MODEL_SQL, '$OUTPUT_CAPTURE_MODE', $OUTPUT_TEXT_SQL, NULL, NULL, NULL, NULL);
    SELECT LAST_INSERT_ID();
" | tail -1)

echo "=== Caller-supplied output recorded ==="
echo "Execution ID: $EXEC_ID"
echo "Outcome: unknown; model execution and accepted work were not verified."
echo "Output capture: $OUTPUT_CAPTURE_MODE"
echo ""
echo "Rate this execution: pv-rate $EXEC_ID <1-5> [notes]"
