#!/usr/bin/env bash
# pv-template-vars - Extract and analyze template variables
# Usage: pv-template-vars <command> [args]
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VAULT_DIR="${VAULT_DIR:-$SCRIPT_DIR/../prompt-vault-db}"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/pv-lib.sh"

ensure_vault

cmd="${1:-list}"
shift || true

ALL_ARGS_PATTERN="\$@"
ARGS_ALIAS_PATTERN="\$ARGUMENTS"
ARG_SLICE_PREFIX="\${@:"

extract_vars() {
    local content="$1"
    printf '%s\n' "$content" | grep -oE "\\\$[0-9]+|\\\$@|\\\$ARGUMENTS|\\\${@:[0-9]+(:[0-9]+)?}" | sort -u || true
}

template_content() {
    local name="$1"
    local escaped_name
    escaped_name=$(sql_escape "$name")
    json_first_field "SELECT content FROM prompt_templates WHERE name = '$escaped_name' AND status = 'active' ORDER BY version DESC LIMIT 1" content
}

template_description() {
    local name="$1"
    local escaped_name
    escaped_name=$(sql_escape "$name")
    json_first_field "SELECT description FROM prompt_templates WHERE name = '$escaped_name' LIMIT 1" description
}

case "$cmd" in
    list)
        name="${1:-}"
        if [ -z "$name" ]; then
            echo "=== All Template Variables ==="
            while IFS= read -r tname; do
                [ -z "$tname" ] && continue
                content=$(template_content "$tname")
                vars=$(extract_vars "$content" | tr '\n' ' ' | sed 's/[[:space:]]\+$//')
                if [ -n "$vars" ]; then
                    echo "$tname: $vars"
                fi
            done < <(json_all_field "SELECT name FROM prompt_templates WHERE status = 'active' ORDER BY name" name)
        else
            content=$(template_content "$name")
            echo "Variables in '$name':"
            extract_vars "$content"
        fi
        ;;

    validate)
        name="${1:-}"
        if [ -z "$name" ]; then
            echo "Validating all templates..."
            while IFS= read -r tname; do
                [ -z "$tname" ] && continue
                content=$(template_content "$tname")
                issues=""

                if printf '%s\n' "$content" | grep -qE '\$[^0-9@{ARGUMENTS}]'; then
                    issues="$issues UNESCAPED_DOLLAR"
                fi

                positions=$(printf '%s\n' "$content" | grep -oE '\$[0-9]+' | grep -oE '[0-9]+' | sort -n | uniq || true)
                max=$(printf '%s\n' "$positions" | tail -1)
                if [ -n "$max" ]; then
                    for i in $(seq 1 "$max"); do
                        if ! printf '%s\n' "$positions" | grep -q "^$i$"; then
                            issues="$issues MISSING_ARG$i"
                        fi
                    done
                fi

                if [ -n "$issues" ]; then
                    echo "⚠ $tname:$issues"
                else
                    echo "✓ $tname"
                fi
            done < <(json_all_field "SELECT name FROM prompt_templates WHERE status = 'active' ORDER BY name" name)
        else
            content=$(template_content "$name")
            echo "Variables:"
            extract_vars "$content"
            echo ""
            echo "Usage example:"
            echo "  /$name arg1 arg2 ..."
        fi
        ;;

    document)
        name="${1:-}"
        [ -z "$name" ] && { echo "Usage: pv-template-vars document <name>" >&2; exit 1; }

        content=$(template_content "$name")
        desc=$(template_description "$name")
        mapfile -t vars < <(extract_vars "$content")

        echo "## $name"
        echo ""
        echo "$desc"
        echo ""
        echo "### Arguments"
        echo ""

        for var in "${vars[@]}"; do
            [ -z "$var" ] && continue
            case "$var" in
                "$ALL_ARGS_PATTERN"|"$ARGS_ALIAS_PATTERN")
                    echo "- \`$var\` - All arguments joined"
                    ;;
                "$ARG_SLICE_PREFIX"*)
                    echo "- \`$var\` - Argument slice"
                    ;;
                *)
                    num=$(printf '%s' "$var" | tr -d '$')
                    echo "- \`$var\` - Positional argument $num"
                    ;;
            esac
        done

        echo ""
        echo "### Example"
        echo ""
        echo "\`\`\`"
        echo "/$name <args>"
        echo "\`\`\`"
        ;;

    usage)
        name="${1:-}"
        [ -z "$name" ] && { echo "Usage: pv-template-vars usage <name>" >&2; exit 1; }

        content=$(template_content "$name")
        mapfile -t vars < <(extract_vars "$content")

        echo "/$name"

        {
            for var in "${vars[@]}"; do
                [ -z "$var" ] && continue
                case "$var" in
                    "$ALL_ARGS_PATTERN"|"$ARGS_ALIAS_PATTERN")
                        echo "  $name <args...>"
                        ;;
                    "$ARG_SLICE_PREFIX"*)
                        echo "  $name <arg1> [arg2] ..."
                        ;;
                    *)
                        echo "  $name ${var}"
                        ;;
                esac
            done
        } | awk '!seen[$0]++' | head -5
        ;;

    help|*)
        cat << 'EOF'
Usage: pv-template-vars <command> [args]

Commands:
  list [name]        List variables in template(s)
  validate [name]    Validate variable patterns
  document <name>    Generate variable documentation
  usage <name>       Show usage patterns

Examples:
  pv-template-vars list              # All templates
  pv-template-vars list preflight    # Specific template
  pv-template-vars validate
  pv-template-vars document review
EOF
        ;;
esac
